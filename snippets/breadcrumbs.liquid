{% comment %}
  Renders the breadcrumb trail for the current template.

  Usage:
  {% render 'breadcrumbs' %}
{% endcomment %}

{%- comment -%}
  One delimiter, reused between every crumb.
{%- endcomment -%}
{%- capture delimiter -%}
  <span class="breadcrumb__delimiter" aria-hidden="true">&raquo;</span>
{%- endcapture -%}

<div class="container">
  <nav id="breadcrumbs" class="breadcrumb" role="navigation" aria-label="breadcrumbs">
    <a href="{{ routes.root_url }}" title="{{ 'general.breadcrumbs.home' | t }}" class="focus-inset">
      {{- 'general.breadcrumbs.home' | t -}}
    </a>

    {%- if template contains 'page' -%}
      {{ delimiter }}
      <span aria-current="page">{{ page.title }}</span>

    {%- elsif template == 'cart' -%}
      {{ delimiter }}
      <span aria-current="page">{{ 'sections.cart.title' | t }}</span>

    {%- elsif template contains 'product' -%}
      {%- if product.collections[0] -%}
        {{ delimiter }}
        <a href="{{ product.collections[0].url }}" class="focus-inset">
          {{- product.collections[0].title -}}
        </a>
      {%- endif -%}
      {{ delimiter }}
      <span aria-current="page">{{ product.title }}</span>

    {%- elsif template == 'blog' -%}
      {{ delimiter }}
      {%- if current_tags -%}
        <a href="{{ blog.url }}" class="focus-inset">{{ blog.title }}</a>
        {{ delimiter }}
        <span aria-current="page">{{ current_tags | join: ' + ' }}</span>
      {%- else -%}
        <span aria-current="page">{{ blog.title }}</span>
      {%- endif -%}

    {%- elsif template contains 'collection' -%}
      {{ delimiter }}
      <span aria-current="page">{{ collection.title }}</span>

    {%- elsif template == 'customers/order' -%}
      {{ delimiter }}
      <a href="{{ routes.account_url }}" class="focus-inset">{{ 'customer.account.title' | t }}</a>
      {{ delimiter }}
      <span aria-current="page">{{ order.name }}</span>

    {%- elsif template == 'customers/addresses' -%}
      {{ delimiter }}
      <a href="{{ routes.account_url }}" class="focus-inset">{{ 'customer.account.title' | t }}</a>
      {{ delimiter }}
      <span aria-current="page">{{ 'customer.addresses.title' | t }}</span>

    {%- else -%}
      {{ delimiter }}
      <span aria-current="page">{{ page_title }}</span>
    {%- endif -%}
  </nav>
</div>
