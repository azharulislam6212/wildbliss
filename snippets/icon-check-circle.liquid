{% comment %}
  Renders a check mark inside a circle.

  Accepts:
  - style: {String} 'outline' (default) or 'filled'.
  - size: {Number} pixel size of the icon (optional, default 20).

  Usage:
  {% render 'icon-check-circle', style: 'filled', size: 24 %}
{% endcomment %}
{%- liquid
  assign icon_size = size | default: 20
  assign icon_style = style | default: 'outline'
-%}
{%- if icon_style == 'filled' -%}
  <svg
    class="icon icon-check-circle icon-check-circle--filled"
    width="{{ icon_size }}"
    height="{{ icon_size }}"
    viewBox="0 0 20 20"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="10" cy="10" r="10" fill="currentColor"/>
    <path
      d="M14.4 6.9a.75.75 0 0 1 0 1.06l-5.3 5.3a.75.75 0 0 1-1.06 0L5.6 11.02a.75.75 0 1 1 1.06-1.06l1.91 1.9 4.77-4.96a.75.75 0 0 1 1.06 0Z"
      fill="var(--icon-check-mark, #FFFDF4)"
    />
  </svg>
{%- else -%}
  <svg
    class="icon icon-check-circle icon-check-circle--outline"
    width="{{ icon_size }}"
    height="{{ icon_size }}"
    viewBox="0 0 20 20"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="10" cy="10" r="9.15" stroke="currentColor" stroke-width="1.2"/>
    <path
      d="M14 7.4 8.87 12.7 6 9.9"
      stroke="currentColor"
      stroke-width="1.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
{%- endif -%}
