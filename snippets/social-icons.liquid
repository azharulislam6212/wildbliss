<path d="M10.625 2.125H9.20833C8.45689 2.125 7.73622 2.42351 7.20486 2.95486C6.67351 3.48622 6.375 4.20689 6.375 4.95833V7.08333H4.25V9.91667H6.375V14.875H9.20833V9.91667H11.3333L12.0417 7.08333H9.20833V4.95833C9.20833 4.77047 9.28296 4.5903 9.4158 4.45747C9.54864 4.32463 9.7288 4.25 9.91667 4.25H11.3333L10.625 2.125Z" stroke="currentColor" stroke-width="1.13333"/>
</svg>

        <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
      </a>
