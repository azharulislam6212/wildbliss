{{ 'section-icon-with-text-scroller.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_tab }}px;
      padding-bottom: {{ section.settings.padding_bottom_tab }}px;
    }
  }

  @media screen and (min-width: 1024px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .icon-text-{{ section.id }} {
    --icon-text-columns: {{ section.settings.columns }};
    --icon-text-pad-top: {{ section.settings.padding_top_mobile }}px;
    --icon-text-pad-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 768px) {
    .icon-text-{{ section.id }} {
      --icon-text-pad-top: {{ section.settings.padding_top_tab }}px;
      --icon-text-pad-bottom: {{ section.settings.padding_bottom_tab }}px;
    }
  }

  @media screen and (min-width: 1024px) {
    .icon-text-{{ section.id }} {
      --icon-text-pad-top: {{ section.settings.padding_top }}px;
      --icon-text-pad-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- if section.settings.show_item_dividers -%}
    /* No divider before the first item of each row */
    @media screen and (min-width: 990px) {
      .icon-text-{{ section.id }} .icon-text-scroller__item:nth-child({{ section.settings.columns }}n + 1)::before {
        display: none;
      }
    }
  {%- endif -%}
{%- endstyle -%}

<section
  class="icon-text-scroller icon-text-{{ section.id }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_dividers %} icon-text-scroller--ruled{% endif %}{% if section.settings.show_item_dividers %} icon-text-scroller--split{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {% if settings.animations_reveal_on_scroll %}
    data-cascade
  {% endif %}
>
  <div class="{{ section.settings.page_width }}">
    <div class="icon-text-scroller__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'item' -%}
            <div class="icon-text-scroller__item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank or block.settings.svg_icon != blank -%}
                <div class="icon-text-scroller__icon">
                  {%- if block.settings.icon != blank -%}
                    {% render 'icon-img' with image, image: block.settings.icon %}
                  {%- else -%}
                    {{ block.settings.svg_icon }}
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="icon-text-scroller__text">
                {%- if block.settings.title != blank -%}
                  <strong class="icon-text-scroller__title">{{ block.settings.title }}</strong>
                {%- endif -%}
                {%- if block.settings.subtitle != blank -%}
                  <span class="icon-text-scroller__subtitle">{{ block.settings.subtitle }}</span>
                {%- endif -%}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Icon With Text",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container-fluid",
          "label": "Full Width"
        }
      ],
      "default": "container-fluid",
      "label": "Layout Width"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "default": true,
      "label": "Show top and bottom rules"
    },
    {
      "type": "checkbox",
      "id": "show_item_dividers",
      "default": true,
      "label": "Show dividers between items"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Desktop",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Desktop",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_top_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Tab",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Tab",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 26
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image",
          "info": "Overrides the custom SVG below."
        },
        {
          "type": "html",
          "id": "svg_icon",
          "label": "Custom SVG",
          "info": "Paste an inline SVG. Use stroke=\"currentColor\" so it picks up the color scheme."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "USDA Organic"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Text",
          "default": "Certified at every step, meadow to canister."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon With Text",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
