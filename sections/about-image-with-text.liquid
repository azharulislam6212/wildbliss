{{ 'section-about-image-with-text .css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 992px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_tab }}px;
      padding-bottom: {{ section.settings.padding_bottom_tab }}px;
    }
  }

  @media screen and (min-width: 1024px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .about-image-with-text-{{ section.id }} {
    --about-accent: {{ section.settings.accent_color }};
    --about-media-width: {{ section.settings.media_width }}fr;
    --about-body-width: {{ 100 | minus: section.settings.media_width }}fr;
    --about-column-gap: {{ section.settings.column_gap }}px;
    --about-card-ratio: {{ section.settings.card_ratio }};
    --about-card-radius: {{ section.settings.card_radius }}px;
    --about-card-fallback: {{ section.settings.card_fallback }};
    --about-heading-size: {{ section.settings.heading_size }}px;
    --about-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --about-quote-indent: {{ section.settings.quote_indent }}px;
  }
{%- endstyle -%}

<div
  class="about-image-with-text about-image-with-text-{{ section.id }} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding gradient isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {% if settings.animations_reveal_on_scroll %}
    data-cascade
  {% endif %}
>
  <div class="{{ section.settings.page_width }}">
    <div class="about-image__wrap">
      {%- comment -%}
        The image block is pulled out of the block loop so it can hold the left
        column on its own, whatever order the blocks sit in.
      {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'image' -%}
          <div class="about-image__figure" {{ block.shopify_attributes }}>
            <div class="about-image__card"
              {% if block.settings.image != blank %}
                style="--about-card-focal: {{ block.settings.image.presentation.focal_point }};"
              {% endif %}
            >
              {%- if block.settings.image != blank -%}
                {% render 'responsive-img',
                  image: block.settings.image,
                  sizes: '(min-width: 990px) 40vw, 100vw'
                %}
              {%- else -%}
              
              
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
           
              {%- endif -%}

              {%- if block.settings.image_caption != blank -%}
                <span class="about-image__card-caption">{{ block.settings.image_caption }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="about-image__body">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'caption' -%}
              {%- if block.settings.caption != blank -%}
                <p class="about-image__eyebrow sub-heading" {{ block.shopify_attributes }}>
                  {{- block.settings.caption | escape -}}
                </p>
              {%- endif -%}

            {%- when 'heading' -%}
              {%- if block.settings.heading != blank -%}
                {%- comment -%}
                  Wrap the accent half of the heading in <em>: it turns italic and
                  takes the accent colour.
                {%- endcomment -%}
                <h2 class="about-image__heading inline-richtext" {{ block.shopify_attributes }}>
                  {{ block.settings.heading }}
                </h2>
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <div class="about-image__text rte" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>
              {%- endif -%}

            {%- when 'block_quote' -%}
              {%- if block.settings.text != blank -%}
                <blockquote class="about-image__quote rte" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </blockquote>
              {%- endif -%}

            {%- when 'attribution' -%}
              {%- if block.settings.text != blank -%}
                <p class="about-image__attribution" {{ block.shopify_attributes }}>
                  {{- block.settings.text -}}
                </p>
              {%- endif -%}

            {%- when 'button' -%}
              {%- if block.settings.button_label != blank -%}
                <a
                  {% if block.settings.button_link == blank %}
                    role="link"
                    aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link }}"
                  {% endif %}
                  class="button button--{{ block.settings.button_style }}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.button_label | escape }}
                </a>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About image with text",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container-fluid",
          "label": "Full Width"
        }
      ],
      "default": "container",
      "label": "Layout Width"
    },
    {
      "type": "color",
      "id": "accent_color",
      "default": "#7A8F55",
      "label": "Accent colour",
      "info": "Used for the italic half of the heading, the attribution and the image caption."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "media_width",
      "min": 25,
      "max": 60,
      "step": 1,
      "unit": "%",
      "label": "Image column width",
      "default": 42
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Gap between columns",
      "default": 64
    },
    {
      "type": "select",
      "id": "card_ratio",
      "options": [
        {
          "value": "476 / 595",
          "label": "Portrait (4:5)"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "auto",
          "label": "Natural image height"
        }
      ],
      "default": "476 / 595",
      "label": "Image shape"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Image corner radius",
      "default": 12
    },
    {
      "type": "color_background",
      "id": "card_fallback",
      "label": "Image placeholder",
      "info": "Shown behind the botanical mark when no image is set.",
      "default": "linear-gradient(160deg, #eef1e1 0%, #e2e8d2 55%, #d5ddc3 100%)"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Heading size on desktop",
      "default": 44
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading size on mobile",
      "default": 30
    },
    {
      "type": "range",
      "id": "quote_indent",
      "min": 0,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Quote indent",
      "default": 24
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Tab",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Tab",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_caption",
          "label": "Caption pill",
          "info": "Optional. Sits in the bottom-left corner of the image."
        }
      ]
    },
    {
      "type": "caption",
      "name": "t:sections.image-with-text.blocks.caption.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "caption",
          "default": "Founder story",
          "label": "t:sections.image-with-text.blocks.caption.settings.text.label"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.image-with-text.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Why Wild Bliss <em>exists.</em>",
          "label": "t:sections.image-with-text.blocks.heading.settings.heading.label",
          "info": "Text inside <em> is italic and takes the accent colour."
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.image-with-text.blocks.text.name",
      "limit": 3,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>I was born in Romania and raised in a remote village near the Carpathians, where nature was part of everyday life.</p>",
          "label": "t:sections.image-with-text.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "block_quote",
      "name": "Block quote",
      "limit": 2,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Wild Bliss was born from that belief: pure Romanian botanicals, carefully sourced and thoughtfully crafted with respect for origin, freshness, and tradition.</p>",
          "label": "t:sections.image-with-text.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "attribution",
      "name": "Attribution",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "— S.I. Farcas, Founder",
          "label": "Text"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.image-with-text.blocks.button.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "t:sections.image-with-text.blocks.button.settings.button_label.default",
          "label": "t:sections.image-with-text.blocks.button.settings.button_label.label",
          "info": "t:sections.image-with-text.blocks.button.settings.button_label.info"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.image-with-text.blocks.button.settings.button_link.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About image with text",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "caption"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "block_quote"
        },
        {
          "type": "attribution"
        }
      ]
    }
  ]
}
{% endschema %}
