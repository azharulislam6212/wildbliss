{{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}

  .section-{{ section.id }}-padding {
    --color-accent: {{ section.settings.color_accent.red }}, 
    {{ section.settings.color_accent.green }}, 
    {{ section.settings.color_accent.blue }};
    --color-link: {{ section.settings.color_accent.red }}, 
    {{ section.settings.color_accent.green }}, 
    {{ section.settings.color_accent.blue }};
  }


  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 992px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_tab }}px;
      padding-bottom: {{ section.settings.padding_bottom_tab }}px;
    }
  }

  @media screen and (min-width: 1024px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}


<div class="color-{{ section.settings.color_scheme }} gradient  section-{{ section.id }}-padding">
  <div class="contact {{ section.settings.page_width }}">


    <div class="contact-flex--wrapper">

      <div class="contact-flex__content">


        <div class="contact-header">

          {% for block in section.blocks %}
            {% case block.type %}

              {%- when 'heading' -%}

                {% if block.settings.heading != blank %}
                  <h2 class="contact-header-title {{ block.settings.heading_size }} {{ block.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ block.shopify_attributes }}>
                    {{ block.settings.heading }}
                  </h2>
                {% endif %}


              {%- when 'text' -%}
                <div class="contact-text__text rte {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %} " {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>

              {% when 'notice' %}
                <div class="contact-notice rte {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %} " {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>

              {% when 'social' %}
                <div class="social__block">
                  <span class="social-title">{{ block.settings.title }}</span>
                  {%- render 'social-icons'
                    , class: 'footer__list-social' -%}
                </div>
            {% endcase %}
          {% endfor %}
        </div>

        <div class="contact-content">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'form' %}
                <div class="contact-form--card color-{{ block.settings.color_scheme }} gradient">
                  {%- if block.settings.heading != blank -%}
                    <h2 class="title title-wrapper--no-top-margin inline-richtext {{ block.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                      {{ block.settings.heading }}
                    </h2>
                  {%- else -%}
                    <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
                  {%- endif -%}
                  {%- liquid
                    assign contact_form_class = 'isolate'
                    if settings.animations_reveal_on_scroll
                      assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
                    endif
                  -%}
                  {%- form 'contact'
                    , id: 'ContactForm'
                    , class: contact_form_class -%}
                    {%- if form.posted_successfully? -%}
                      <h2
                        class="form-status form-status-list form__message"
                        tabindex="-1"
                        autofocus>
                        {{- 'icon-success.svg' | inline_asset_content -}}
                        {{ 'templates.contact.form.post_success' | t }}
                      </h2>
                    {%- elsif form.errors -%}
                      <div class="form__message">
                        <h2
                          class="form-status caption-large text-body"
                          role="alert"
                          tabindex="-1"
                          autofocus>
                          {{- 'icon-error.svg' | inline_asset_content -}}
                          {{ 'templates.contact.form.error_heading' | t }}
                        </h2>
                      </div>
                      <ul class="form-status-list caption-large" role="list">
                        <li>
                          <a href="#ContactForm-email" class="link">
                            {{ form.errors.translated_fields.email | capitalize }}
                            {{ form.errors.messages.email }}
                          </a>
                        </li>
                      </ul>
                    {%- endif -%}
                    <div class="contact__fields">
                      <div class="form-group">
                        <label class="form-input__label" for="ContactForm-name">
                          {{- 'templates.contact.form.name' | t -}}
                          <span aria-hidden="true">*</span>
                        </label>
                        <input
                          class="form__input"
                          autocomplete="name"
                          type="text"
                          id="ContactForm-name"
                          aria-required="true"
                          name="contact[{{ 'templates.contact.form.name' | t }}]"
                          value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                          placeholder="Enter Full Name">
                      </div>
                      <div class="form-group">
                        <label class="form-input__label" for="ContactForm-phone">
                          {{- 'templates.contact.form.phone' | t -}}
                        </label>
                        <input
                          type="tel"
                          id="ContactForm-phone"
                          class="form__input"
                          autocomplete="tel"
                          name="contact[{{ 'templates.contact.form.phone' | t }}]"
                          pattern="[0-9\-]*"
                          value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                          placeholder="00 (123) 000 0000">
                      </div>


                    </div>

                    <div class="contact__fields">


                      <div class="form-group field--with-error">
                        <label class="form-input__label" for="ContactForm-email">
                          {{- 'templates.contact.form.email' | t }}
                          <span aria-hidden="true">*</span>
                        </label>
                        <input
                          autocomplete="email"
                          type="email"
                          id="ContactForm-email"
                          class="form__input"
                          name="contact[email]"
                          spellcheck="false"
                          autocapitalize="off"
                          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                          aria-required="true"
                          {% if form.errors contains 'email' %}
                          aria-invalid="true"
                          aria-describedby="ContactForm-email-error"
                          {% endif %}
                          placeholder="jhon@example.com">

                        {%- if form.errors contains 'email' -%}
                          <small class="contact__field-error" id="ContactForm-email-error">
                            <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                            <span class="form__message">
                              <span class="svg-wrapper">
                                {{- 'icon-error.svg' | inline_asset_content -}}
                              </span>
                              {{- form.errors.translated_fields.email | capitalize }}
                              {{ form.errors.messages.email -}}
                            </span>
                          </small>
                        {%- endif -%}
                      </div>


                      <div class="form-group">
                        <label for="reason" class="form-input__label">Reason for contact *</label>

                        <select
                          id="reason"
                          name="contact[Reason]"
                          required
                          class="form__input__select">
                          <option value="">Select one</option>
                          <option value="General Inquiry">General Inquiry</option>
                          <option value="Order Support">Order Support</option>
                          <option value="Wholesale">Wholesale</option>
                        </select>
                      </div>


                    </div>


                    <div class="form-group">
                      <label class="form-input__label" for="ContactForm-body">
                        {{- 'templates.contact.form.comment' | t -}}
                      </label>
                      <textarea
                        rows="10"
                        id="ContactForm-body"
                        class="text-area form__input"
                        name="contact[{{ 'templates.contact.form.comment' | t }}]"
                        placeholder="Write Your Message">
                        {{- form.body -}}
                      </textarea>
                    </div>
                    <div class="contact__button">
                      <button type="submit" class="button button--icon button--{{  block.settings.button_style }}">

                        {{ 'templates.contact.form.send' | t }}
                      </button>
                    </div>
                  {%- endform -%}
                </div>
            {% endcase %}
          {% endfor %}
        </div>

        <div class="contact--divider"></div>

        {% for block in section.blocks %}
          {% case block.type %}

            {% when 'icon_block_heading' %}

              <h3 class="contact-icon__heading">{{ block.settings.heading }}</h3>
          {% endcase %}
        {% endfor %}
        <div class="contact-icon-blocks">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'icon_block' %}
                <div class="contact-icon-item  color-{{ section.settings.color_scheme_card }} gradient   {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                  {% if block.settings.icon != blank %}
                    <div class="contact-icon">
                      {% render 'icon-img' with image: block.settings.icon %}
                    </div>
                  {% endif %}

                  <div class="contact-icon-text">
                    <h3 class="contact-icon-title">{{ block.settings.title }}</h3>
                    {{ block.settings.text }}
                  </div>
                </div>
            {% endcase %}
          {% endfor %}
        </div>

        <div class="contact--divider"></div>


        <div class="contact-map-wrapper">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'map' %}
                <div class="map-block--wrapper">
                  {{ block.settings.map }}
                </div>
            {% endcase %}
          {% endfor %}
        </div>

      </div>

      <div class="contact-flex__sidebar">

        <div class="sidebar__inner">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'image_widget' %}

                <div class="widget-card image_widget-card color-{{ section.settings.color_scheme_card }} gradient" {{ block.shopify_attributes }}>


                  <h3 class="widget-card__title">{{ block.settings.heading }}</h3>

                  {% if block.settings.image %}

                    <div class="widget-card__img">
                      {% render 'responsive-img' with image: block.settings.image %}
                    </div>


                  {% endif %}

                  {% if block.settings.button_label != blank %}
                    <a href="{{ block.settings.button_link }}" class="button-link--widget">
                      {{ block.settings.button_label }}
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 14 14"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg">
                        <path d="M12.122 7.30953L8.18453 11.247C8.10244 11.3291 7.9911 11.3752 7.875 11.3752C7.7589 11.3752 7.64756 11.3291 7.56547 11.247C7.48338 11.1649 7.43726 11.0536 7.43726 10.9375C7.43726 10.8214 7.48338 10.7101 7.56547 10.628L10.7565 7.4375H2.1875C2.07147 7.4375 1.96019 7.39141 1.87814 7.30936C1.79609 7.22731 1.75 7.11603 1.75 7C1.75 6.88397 1.79609 6.77269 1.87814 6.69064C1.96019 6.60859 2.07147 6.5625 2.1875 6.5625H10.7565L7.56547 3.37203C7.48338 3.28994 7.43726 3.1786 7.43726 3.0625C7.43726 2.9464 7.48338 2.83506 7.56547 2.75297C7.64756 2.67088 7.7589 2.62476 7.875 2.62476C7.9911 2.62476 8.10244 2.67088 8.18453 2.75297L12.122 6.69047C12.1627 6.7311 12.195 6.77935 12.217 6.83246C12.239 6.88557 12.2503 6.9425 12.2503 7C12.2503 7.05749 12.239 7.11442 12.217 7.16754C12.195 7.22065 12.1627 7.2689 12.122 7.30953Z" fill="currentColor" />
                      </svg>
                    </a>
                  {% endif %}

                </div>


              {% when 'icon_widget' %}


                <div class="widget-card icon_widget-card color-{{ section.settings.color_scheme_card }} gradient" {{ block.shopify_attributes }}>


                  <h3 class="widget-card__title">{{ block.settings.heading }}</h3>

                  <div class="widget-card__icon-block">

              

                  {% if block.settings.icon %}
                    <div class="widget-card__icon">
                      {% render 'icon-img' with image: block.settings.icon %}
                    </div>
                  {% endif %}

                    {{ block.settings.text }} 

                  {% if block.settings.button_label != blank %}
                    <a href="{{ block.settings.button_link }}" class="button-link--widget">
                      {{ block.settings.button_label }}
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 14 14"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg">
                        <path d="M12.122 7.30953L8.18453 11.247C8.10244 11.3291 7.9911 11.3752 7.875 11.3752C7.7589 11.3752 7.64756 11.3291 7.56547 11.247C7.48338 11.1649 7.43726 11.0536 7.43726 10.9375C7.43726 10.8214 7.48338 10.7101 7.56547 10.628L10.7565 7.4375H2.1875C2.07147 7.4375 1.96019 7.39141 1.87814 7.30936C1.79609 7.22731 1.75 7.11603 1.75 7C1.75 6.88397 1.79609 6.77269 1.87814 6.69064C1.96019 6.60859 2.07147 6.5625 2.1875 6.5625H10.7565L7.56547 3.37203C7.48338 3.28994 7.43726 3.1786 7.43726 3.0625C7.43726 2.9464 7.48338 2.83506 7.56547 2.75297C7.64756 2.67088 7.7589 2.62476 7.875 2.62476C7.9911 2.62476 8.10244 2.67088 8.18453 2.75297L12.122 6.69047C12.1627 6.7311 12.195 6.77935 12.217 6.83246C12.239 6.88557 12.2503 6.9425 12.2503 7C12.2503 7.05749 12.239 7.11442 12.217 7.16754C12.195 7.22065 12.1627 7.2689 12.122 7.30953Z" fill="currentColor" />
                      </svg>
                    </a>
                  {% endif %}

                      </div>



                </div>


              {% endcase %}
            {% endfor %}
          </div>

        </div>
      </div>


    </div>


  </div>

  {% schema %}
    {
      "name": "t:sections.contact-form.name",
      "tag": "section",
      "class": "section",
      "disabled_on": {
        "groups": ["header", "footer"]
      },
      "settings": [
        {
          "type": "select",
          "id": "page_width",
          "options": [
            {
              "value": "container",
              "label": "Container"
            }, {
              "value": "container-fluid",
              "label": "Full Width"
            }
          ],
          "default": "container-fluid",
          "label": "Layout Width"
        },
        {
          "type": "color",
          "id": "color_accent",
          "label": "Accent Color",
          "default": "#FF0000"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "default": "scheme-1"
        },

        {
          "type": "color_scheme",
          "id": "color_scheme_card",
          "label": "t:sections.all.colors.label",
          "default": "scheme-2"
        }, {
          "type": "header",
          "content": "t:sections.all.padding.section_padding_heading"
        }, {
          "type": "range",
          "id": "padding_top",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "t:sections.all.padding.padding_top",
          "default": 120
        }, {
          "type": "range",
          "id": "padding_bottom",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "t:sections.all.padding.padding_bottom",
          "default": 120
        }, {
          "type": "range",
          "id": "padding_top_tab",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "Padding Top Tab",
          "default": 80
        }, {
          "type": "range",
          "id": "padding_bottom_tab",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "Padding Bottom Tab",
          "default": 80
        }, {
          "type": "range",
          "id": "padding_top_mobile",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "Padding Top Mobile",
          "default": 48
        }, {
          "type": "range",
          "id": "padding_bottom_mobile",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "Padding Bottom Mobile",
          "default": 48
        }
      ],
      "blocks": [
        {
          "type": "heading",
          "name": "Heading",
          "limit": 1,
          "settings": [
            {
              "type": "inline_richtext",
              "id": "heading",
              "default": "t:sections.contact-form.settings.title.default",
              "label": "t:sections.contact-form.settings.title.label"
            }, {
              "type": "select",
              "id": "heading_size",
              "options": [
                {
                  "value": "h2",
                  "label": "t:sections.all.heading_size.options__1.label"
                },
                {
                  "value": "h1",
                  "label": "t:sections.all.heading_size.options__2.label"
                },
                {
                  "value": "h0",
                  "label": "t:sections.all.heading_size.options__3.label"
                },
                {
                  "value": "hxl",
                  "label": "t:sections.all.heading_size.options__4.label"
                }, {
                  "value": "hxxl",
                  "label": "t:sections.all.heading_size.options__5.label"
                }
              ],
              "default": "h1",
              "label": "t:sections.all.heading_size.label"
            }
          ]
        },
        {
          "type": "map",
          "name": "Map",
          "settings": [
            {
              "type": "liquid",
              "id": "map",
              "label": "Map"
            }
          ]
        },
        {
          "type": "form",
          "name": "Form",
          "limit": 1,
          "settings": [
            {
              "type": "inline_richtext",
              "id": "heading",
              "default": "t:sections.contact-form.settings.title.default",
              "label": "t:sections.contact-form.settings.title.label"
            }, {
              "type": "select",
              "id": "heading_size",
              "options": [
                {
                  "value": "h2",
                  "label": "t:sections.all.heading_size.options__1.label"
                },
                {
                  "value": "h1",
                  "label": "t:sections.all.heading_size.options__2.label"
                },
                {
                  "value": "h0",
                  "label": "t:sections.all.heading_size.options__3.label"
                },
                {
                  "value": "hxl",
                  "label": "t:sections.all.heading_size.options__4.label"
                }, {
                  "value": "hxxl",
                  "label": "t:sections.all.heading_size.options__5.label"
                }
              ],
              "default": "h1",
              "label": "t:sections.all.heading_size.label"
            }, {
              "type": "select",
              "id": "button_style",
              "label": "Button style",
              "options": [
                {
                  "value": "primary",
                  "label": "Primary"
                }, {
                  "value": "secondary",
                  "label": "Secondary"
                }
              ],
              "default": "primary"
            }, {
              "type": "color_scheme",
              "id": "color_scheme",
              "label": "t:sections.all.colors.label",
              "default": "scheme-2"
            }
          ]
        },
        {
          "type": "social",
          "name": "Social",
          "settings": [
            {
              "type": "text",
              "id": "title",
              "default": "Follow Us",
              "label": "Title"
            }
          ]
        }, {
          "type": "text",
          "name": "t:sections.image-with-text.blocks.text.name",
          "limit": 1,
          "settings": [
            {
              "type": "richtext",
              "id": "text",
              "default": "t:sections.image-with-text.blocks.text.settings.text.default",
              "label": "t:sections.image-with-text.blocks.text.settings.text.label"
            }, {
              "type": "select",
              "id": "text_style",
              "options": [
                {
                  "value": "body",
                  "label": "t:sections.image-with-text.blocks.text.settings.text_style.options__1.label"
                }, {
                  "value": "subtitle",
                  "label": "t:sections.image-with-text.blocks.text.settings.text_style.options__2.label"
                }, {
                  "value": "caption-with-letter-spacing",
                  "label": "t:sections.image-with-text.blocks.caption.settings.text_style.options__2.label"
                }
              ],
              "default": "body",
              "label": "t:sections.image-with-text.blocks.text.settings.text_style.label"
            }, {
              "type": "select",
              "id": "text_size",
              "options": [
                {
                  "value": "extra",
                  "label": "Extra Small"
                }, {
                  "value": "small",
                  "label": "t:sections.image-with-text.blocks.caption.settings.caption_size.options__1.label"
                }, {
                  "value": "medium",
                  "label": "t:sections.image-with-text.blocks.caption.settings.caption_size.options__2.label"
                }, {
                  "value": "large",
                  "label": "t:sections.image-with-text.blocks.caption.settings.caption_size.options__3.label"
                }
              ],
              "default": "medium",
              "label": "t:sections.image-with-text.blocks.caption.settings.caption_size.label"
            }
          ]
        }, {
          "type": "notice",
          "name": "Notice",
          "limit": 1,
          "settings": [
            {
              "type": "richtext",
              "id": "text",
              "default": "<p>Visit our FAQ page for the most common questions.</p>",
              "label": "Notice text"
            }
          ]
        }, {
          "type": "icon_block_heading",
          "name": "Icon Block Heading",
          "limit": 1,
          "settings": [
            {
              "type": "inline_richtext",
              "id": "heading",
              "default": "Just look for “Sir Rose”, our famous four-legged statue and you’ll know you’ve found us!",
              "label": "Notice text"
            }
          ]
        },
         {
          "type": "icon_block",
          "name": "Icon block",
          "limit": 3,
          "settings": [
            {
              "type": "image_picker",
              "id": "icon",
              "label": "icon/image"
            }, {
              "type": "text",
              "id": "title",
              "label": "Title",
              "default": "Our Phone:"
            }, {
              "type": "richtext",
              "id": "text",
              "label": "Text",
              "default": "<p>541-345-0354</p>"
            }
          ]
        },
        {
          "type": "image_widget",
          "name": "Image widget (Sidebar)",
          "limit": 3,
          "settings": [
            {
              "type": "image_picker",
              "id": "image",
              "label": "Image"
            }, {
              "type": "text",
              "id": "heading",
              "label": "Title",
              "default": "Ask About Our Exceptional Pet Foods"
            }, {
              "type": "text",
              "id": "button_label",
              "label": "Button Label",
              "default": "SHOP NOW"
            }, {
              "type": "url",
              "id": "button_link",
              "label": "Button Link"
            }
          ]
        }, {
          "type": "icon_widget",
          "name": "Icon widget (Sidebar)",
          "limit": 3,
          "settings": [
            {
              "type": "image_picker",
              "id": "icon",
              "label": "icon/image"
            },
            {
              "type": "text",
              "id": "heading",
              "label": "Heading",
              "default": "Selections & Special Orders"
            },
            {
              "type": "richtext",
              "id": "text",
              "label": "Text",
              "default": "<p>Please call for availability of products as not all items are available at all times.</p>"
            },
            {
              "type": "text",
              "id": "button_label",
              "label": "Button Label",
              "default": "CALL US"
            }, {
