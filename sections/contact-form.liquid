{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 992px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_tab }}px;
      padding-bottom: {{ section.settings.padding_bottom_tab }}px;
    }
  }

  @media screen and (min-width: 1024px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .contact-form-{{ section.id }} {
    --contact-form-eyebrow: {{ section.settings.eyebrow_color }};
    --contact-form-accent: {{ section.settings.accent_color }};
  }
{%- endstyle -%}

<div
  class="contact-form-section contact-form-{{ section.id }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {% if settings.animations_reveal_on_scroll %}
    data-cascade
  {% endif %}
>
  <div class="{{ section.settings.page_width }}">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="contact-form__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="contact-form__eyebrow sub-heading">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          {%- comment -%}
            Wrap the accent half of the heading in <em>: it turns italic and
            takes the accent colour.
          {%- endcomment -%}
          <h2 class="contact-form__heading hxl inline-richtext">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="contact-form__card color-{{ section.settings.color_scheme_card }} gradient">
      {%- form 'contact', id: 'ContactForm', class: 'contact-form__form' -%}
        {%- if form.posted_successfully? -%}
          <h3 class="contact-form__status form-status form__message" tabindex="-1" autofocus>
            {{- 'icon-success.svg' | inline_asset_content -}}
            {{ 'templates.contact.form.post_success' | t }}
          </h3>
        {%- elsif form.errors -%}
          <div class="form__message">
            <h3 class="contact-form__status form-status" role="alert" tabindex="-1" autofocus>
              {{- 'icon-error.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.error_heading' | t }}
            </h3>
          </div>
          <ul class="contact-form__status-list form-status-list" role="list">
            <li>
              <a href="#ContactForm-email" class="link">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </a>
            </li>
          </ul>
        {%- endif -%}

        <div class="contact-form__row">
          <div class="contact-form__field">
            <label class="contact-form__label" for="ContactForm-name">
              {{- 'templates.contact.form.name' | t -}}
            </label>
            <input
              class="contact-form__input"
              type="text"
              id="ContactForm-name"
              name="contact[Name]"
              autocomplete="name"
              aria-required="true"
              required
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            >
          </div>

          <div class="contact-form__field">
            <label class="contact-form__label" for="ContactForm-email">
              {{- 'templates.contact.form.email' | t -}}
            </label>
            <input
              class="contact-form__input"
              type="email"
              id="ContactForm-email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              aria-required="true"
              required
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="ContactForm-email-error"
              {% endif %}
            >
            {%- if form.errors contains 'email' -%}
              <small class="contact-form__error" id="ContactForm-email-error">
                <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </small>
            {%- endif -%}
          </div>
        </div>

        {%- if section.settings.subject_options != blank -%}
          <div class="contact-form__field">
            <label class="contact-form__label" for="ContactForm-subject">
              {{- 'templates.contact.form.subject' | t -}}
            </label>
            <div class="contact-form__select-wrap">
              <select class="contact-form__select" id="ContactForm-subject" name="contact[Subject]">
                {%- assign subject_options = section.settings.subject_options | newline_to_br | split: '<br />' -%}
                {%- for option in subject_options -%}
                  {%- assign option_label = option | strip_newlines | strip -%}
                  {%- if option_label != blank -%}
                    <option value="{{ option_label | escape }}">{{ option_label }}</option>
                  {%- endif -%}
                {%- endfor -%}
              </select>
              <span class="contact-form__caret" aria-hidden="true">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </div>
          </div>
        {%- endif -%}

        <div class="contact-form__field">
          <label class="contact-form__label" for="ContactForm-body">
            {{- 'templates.contact.form.comment' | t -}}
          </label>
          <textarea class="contact-form__textarea" rows="6" id="ContactForm-body" name="contact[body]">
            {{- form.body -}}
          </textarea>
        </div>

        {%- liquid
          assign button_label = section.settings.button_label
          if button_label == blank
            assign button_label = 'templates.contact.form.send' | t
          endif
        -%}
        <button type="submit" class="button button--primary contact-form__submit">
          {{ button_label | escape }}
        </button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container-fluid",
          "label": "Full Width"
        }
      ],
      "default": "container",
      "label": "Layout Width"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Write to us"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.contact-form.settings.title.label",
      "info": "Wrap the accent words in <em> to set them italic in the accent colour.",
      "default": "Send a <em>message.</em>"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow colour",
      "default": "#a05e12"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Heading accent colour",
      "default": "#7a8f55"
    },
    {
      "type": "textarea",
      "id": "subject_options",
      "label": "Subject options",
      "info": "One option per line. Leave empty to hide the subject field.",
      "default": "Customer support\nOrder support\nWholesale\nGeneral enquiry"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Send Message"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_card",
      "label": "Card Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Tab",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Tab",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
