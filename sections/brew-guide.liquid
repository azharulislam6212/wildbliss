{{ 'section-brew-guide.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 992px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_tab }}px;
      padding-bottom: {{ section.settings.padding_bottom_tab }}px;
    }
  }

  @media screen and (min-width: 1024px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .brew-guide-{{ section.id }} {
    --brew-accent: {{ section.settings.accent_color }};
    --brew-columns: {{ section.blocks.size | at_least: 1 | at_most: 4 }};
    --brew-columns-mobile: {{ section.settings.columns_mobile }};
  }
{%- endstyle -%}

<div
  class="brew-guide brew-guide-{{ section.id }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {% if settings.animations_reveal_on_scroll %}
    data-cascade
  {% endif %}
>
  <div class="{{ section.settings.page_width }}">
    <div class="brew-guide__inner">
      {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
        <h2 class="brew-guide__heading">
          {%- if section.settings.heading != blank -%}
            <span class="brew-guide__heading-line">{{ section.settings.heading }}</span>
          {%- endif -%}
          {%- if section.settings.heading_accent != blank -%}
            <span class="brew-guide__heading-line brew-guide__heading-accent">
              {{- section.settings.heading_accent -}}
            </span>
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="brew-guide__cards" role="list">
          {%- for block in section.blocks -%}
            <li class="brew-guide__card  color-{{ section.settings.color_scheme_card }} gradient" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank or block.settings.icon != 'none' -%}
                <span class="brew-guide__icon">
                  {%- if block.settings.image != blank -%}
                    <img
                      src="{{ block.settings.image | image_url: width: 120 }}"
                      alt="{{ block.settings.image.alt | escape }}"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                      loading="lazy"
                    >
                  {%- else -%}
                    {%- render 'icon-brew', icon: block.settings.icon -%}
                  {%- endif -%}
                </span>
              {%- endif -%}

              {%- if block.settings.value != blank or block.settings.label != blank -%}
                <span class="brew-guide__text">
                  {%- if block.settings.value != blank -%}
                    <span class="brew-guide__value">{{ block.settings.value }}</span>
                  {%- endif -%}
                  {%- if block.settings.label != blank -%}
                    <span class="brew-guide__label">{{ block.settings.label }}</span>
                  {%- endif -%}
                </span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brew Guide",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "The perfect",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "default": "cup.",
      "label": "Heading accent",
      "info": "Shown on its own line in italics, in the accent colour."
    },
    {
      "type": "color",
      "id": "accent_color",
      "default": "#7A8F55",
      "label": "Accent colour",
      "info": "Used for the heading accent line."
    },
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container-fluid",
          "label": "Full Width"
        }
      ],
      "default": "container",
      "label": "Layout Width"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "1",
      "label": "Cards per row on mobile"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-6"
    },
       {
      "type": "color_scheme",
      "id": "color_scheme_card",
      "label": "Card color",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Tab",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Tab",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "options": [
            {
              "value": "cup",
              "label": "Cup"
            },
            {
              "value": "temperature",
              "label": "Temperature"
            },
            {
              "value": "time",
              "label": "Time"
            },
            {
              "value": "none",
              "label": "None"
            }
          ],
          "default": "cup",
          "label": "Icon"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon",
          "info": "Optional. Replaces the icon above."
        },
        {
          "type": "text",
          "id": "value",
          "default": "1 bag",
          "label": "Value"
        },
        {
          "type": "text",
          "id": "label",
          "default": "Per cup",
          "label": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brew Guide",
      "blocks": [
        {
          "type": "spec",
          "settings": {
            "icon": "cup",
            "value": "1 bag",
            "label": "Per cup"
          }
        },
        {
          "type": "spec",
          "settings": {
            "icon": "temperature",
            "value": "95°C",
            "label": "Water"
          }
        },
        {
          "type": "spec",
          "settings": {
            "icon": "time",
            "value": "5–7 min",
            "label": "Covered steep"
          }
        }
      ]
    }
  ]
}
{% endschema %}
