{{ 'section-brew-guide.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Content comes from the product's custom.brew_guide metaobject when one is
  linked: its heading fields override the section's, and its cards replace
  the section's blocks. Products without one fall back to the section.
{%- endcomment -%}
{%- liquid
  assign guide = product.metafields.custom.brew_guide.value

  assign heading = section.settings.heading
  assign heading_accent = section.settings.heading_accent
  assign card_count = section.blocks.size
  assign guide_cards = blank

  if guide != blank
    if guide.heading.value != blank
      assign heading = guide.heading.value | escape
    endif
    if guide.heading_accent.value != blank
      assign heading_accent = guide.heading_accent.value | escape
    endif
    if guide.cards.value.size > 0
      assign guide_cards = guide.cards.value
      assign card_count = guide_cards.size
    endif
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 992px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_tab }}px;
      padding-bottom: {{ section.settings.padding_bottom_tab }}px;
    }
  }

  @media screen and (min-width: 1024px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .brew-guide-{{ section.id }} {
    --brew-accent: {{ section.settings.accent_color }};
    --brew-columns: {{ card_count | at_least: 1 | at_most: 4 }};
    --brew-columns-mobile: {{ section.settings.columns_mobile }};
    --brew-image-text: {{ section.settings.image_text_color | default: '#ffffff' }};
  }
{%- endstyle -%}

<div
  class="brew-guide brew-guide-{{ section.id }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {% if settings.animations_reveal_on_scroll %}
    data-cascade
  {% endif %}
>
  <div class="{{ section.settings.page_width }}">
    <div class="brew-guide__inner">
      {%- if heading != blank or heading_accent != blank -%}
        <h2 class="brew-guide__heading">
          {%- if heading != blank -%}
            <span class="brew-guide__heading-line">{{ heading }}</span>
          {%- endif -%}
          {%- if heading_accent != blank -%}
            <span class="brew-guide__heading-line brew-guide__heading-accent">
              {{- heading_accent -}}
            </span>
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- if card_count > 0 -%}
        <ul class="brew-guide__cards" role="list">
          {%- if guide_cards != blank -%}
            {%- for card in guide_cards -%}
              {%- liquid
                # The icon field may be the preset name (text) or the icon
                # file itself; a file goes to the image slot instead.
                assign card_icon = 'none'
                assign card_image = card.icon_image.value | default: card.image.value
                if card.icon.type contains 'file_reference' or card.icon.type contains 'url'
                  if card_image == blank
                    assign card_image = card.icon.value
                  endif
                elsif card.icon.value != blank
                  assign card_icon = card.icon.value | downcase | strip
                endif

                # Image fields may be a single file or a "list of files"
                # (MediaListDrop). A list has no URL of its own, so take its
                # first file; a for loop is the one way that works on both.
                if card.icon_image.type contains 'list.'
                  for file in card.icon_image.value limit: 1
                    assign card_image = file
                  endfor
                endif

                assign card_bg = card.background_image.value
                if card.background_image.type contains 'list.'
                  assign card_bg = blank
                  for file in card.background_image.value limit: 1
                    assign card_bg = file
                  endfor
                endif

                assign card_value = card.value.value | escape
                assign card_label = card.label.value | escape
              -%}
              {%- render 'brew-guide-card',
                icon: card_icon,
                image: card_image,
                bg_image: card_bg,
                value: card_value,
                label: card_label,
                color_scheme: section.settings.color_scheme_card,
                overlay_color: section.settings.overlay_color
              -%}
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- render 'brew-guide-card',
                icon: block.settings.icon,
                image: block.settings.image,
                bg_image: block.settings.bg_image,
                value: block.settings.value,
                label: block.settings.label,
                color_scheme: section.settings.color_scheme_card,
                overlay_color: section.settings.overlay_color,
                attributes: block.shopify_attributes
              -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brew Guide",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Products with a Brew guide metaobject (custom.brew_guide) use its heading and cards. The settings and blocks below are the fallback for products without one."
    },
    {
      "type": "text",
      "id": "heading",
      "default": "The perfect",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "default": "cup.",
      "label": "Heading accent",
      "info": "Shown on its own line in italics, in the accent colour."
    },
    {
      "type": "color",
      "id": "accent_color",
      "default": "#7A8F55",
      "label": "Accent colour",
      "info": "Used for the heading accent line."
    },
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container-fluid",
          "label": "Full Width"
        }
      ],
      "default": "container",
      "label": "Layout Width"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "1",
      "label": "Cards per row on mobile"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-6"
    },
       {
      "type": "color_scheme",
      "id": "color_scheme_card",
      "label": "Card color",
      "default": "scheme-1"
    },
    {
      "type": "color_background",
      "id": "overlay_color",
      "label": "Overlay card color",
      "info": "Sits over the card background image. Use alpha above 0, or the overlay is invisible.",
      "default": "linear-gradient(to top, rgba(18, 22, 14, 0.85), rgba(18, 22, 14, 0.55), rgba(18, 22, 14, 0.25))"
    },
    {
      "type": "color",
      "id": "image_text_color",
      "label": "Text colour on image cards",
      "info": "Used on cards that have a background image, so the copy reads over a dark overlay.",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Tab",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Tab",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "options": [
            {
              "value": "cup",
              "label": "Cup"
            },
            {
              "value": "temperature",
              "label": "Temperature"
            },
            {
              "value": "time",
              "label": "Time"
            },
            {
              "value": "none",
              "label": "None"
            }
          ],
          "default": "cup",
          "label": "Icon"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon",
          "info": "Optional. Replaces the icon above."
        },
        {
          "type": "image_picker",
          "id": "bg_image",
          "label": "Card background image",
          "info": "Optional. Leave empty to keep the default card background."
        },
        {
          "type": "text",
          "id": "value",
          "default": "1 bag",
          "label": "Value"
        },
        {
          "type": "text",
          "id": "label",
          "default": "Per cup",
          "label": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brew Guide",
      "blocks": [
        {
          "type": "spec",
          "settings": {
            "icon": "cup",
            "value": "1 bag",
            "label": "Per cup"
          }
        },
        {
          "type": "spec",
          "settings": {
            "icon": "temperature",
            "value": "95°C",
            "label": "Water"
          }
        },
        {
          "type": "spec",
          "settings": {
            "icon": "time",
            "value": "5–7 min",
            "label": "Covered steep"
          }
        }
      ]
    }
  ]
}
{% endschema %}
