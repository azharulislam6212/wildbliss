{{ 'section-call-to-action.css' | asset_url | stylesheet_tag }}
{%- style -%}

  .section-{{ section.id }}-padding {
    --color-accent: {{ section.settings.color_accent.red }}, {{ section.settings.color_accent.green }},  {{ section.settings.color_accent.blue }};
    --color-link: {{ section.settings.color_accent.red }}, 
    {{ section.settings.color_accent.green }}, 
    {{ section.settings.color_accent.blue }};
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 992px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_tab }}px;
      padding-bottom: {{ section.settings.padding_bottom_tab }}px;
    }
  }

  @media screen and (min-width: 1024px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="call-to-action-section color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding gradient  isolate {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {% if settings.animations_reveal_on_scroll %}
  data-cascade
  {% endif %}>
  <div class="{{ section.settings.page_width }}">
    <div class="row  align-items-start">
      <div class="col-12">
        <div class="call-to-action__inner">
          <div class="call-to-action__block">
            {%- for block in section.blocks -%}
              {% case block.type %}
                {%- when 'heading' -%}
                  <h2 class="call-to-action__heading inline-richtext {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                    {{ block.settings.heading }}
                  </h2>
                {%- when 'caption' -%}
                  <p class="call-to-action__text image-with-text__text--caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                    {{ block.settings.caption | escape }}
                  </p>
                {%- when 'text' -%}
                  <div class="call-to-action__text rte {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} " {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {%- when 'button' -%}
                  {%- if block.settings.button_label != blank -%}
                    <a
                      {% if block.settings.button_link == blank %}
                      role="link"
                      aria-disabled="true"
                      {% else %}
                      href="{{ block.settings.button_link }}"
                      {% endif %}
                      class="button button--icon button--{{  block.settings.button_style }}"
                      {{ block.shopify_attributes }}>


                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
          <div class="call-to-action__icon-block">
            {% for block in section.blocks %}
            {% case block.type %}
              {% when 'icon_block' %}
                <div class="call-icon-item  color-{{ section.settings.color_scheme_card }} gradient   {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"  style=" --color-accent: {{ section.settings.color_accent.red }}, {{ section.settings.color_accent.green }},  {{ section.settings.color_accent.blue }};">
                  {% if block.settings.icon != blank %}
                    <div class="call-icon">
                      {% render 'icon-img' with image, image: block.settings.icon %}
                    </div>
                  {% endif %}

                  <div class="call-icon-text">
                    <h3 class="call-icon-title">{{ block.settings.title }}</h3>
                    {{ block.settings.text }}
                  </div>
                </div>
            {% endcase %}
          {% endfor %}

          </div>


        </div>
      </div>
    </div>
  </div>
</div>

