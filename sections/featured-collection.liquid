{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'featured-collection.css' | asset_url | stylesheet_tag }}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_tab }}px;
      padding-bottom: {{ section.settings.padding_bottom_tab }}px;
    }
  }

  @media screen and (min-width: 1024px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign column = section.settings.column
  assign column_medium = section.settings.column_medium
  assign column_mobile = section.settings.column_mobile

  assign grid_cols_mobile = 1
  if column_mobile == '2'
    assign grid_cols_mobile = 2
  endif

  assign is_carousel = false
  if section.settings.layout_type == 'carousel'
    assign is_carousel = true
  endif

  assign is_mobile_carousel = false
  if is_carousel == false and section.settings.enable_mobile_carousel
    assign is_mobile_carousel = true
  endif

  assign show_arrows = false
  if is_carousel or is_mobile_carousel
    assign show_arrows = true
  endif

  assign show_view_all = false
  if section.settings.show_view_all and section.settings.collection.url != blank
    assign show_view_all = true
  endif

  assign delay = section.settings.autoplay_timeout | times: 1000
-%}

{%- capture nav_arrows -%}
  <div class="featured-collection__nav color-{{ section.settings.color_scheme_swiper }}">
    <button type="button" class="featured-collection__arrow swiper-button-prev" aria-label="{{ 'general.slider.previous_slide' | t }}">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
        <path d="M12.6668 8H3.3335M7.3335 12L3.3335 8L7.3335 4" stroke="currentColor" stroke-width="1.33333"/>
      </svg>
    </button>
    <button type="button" class="featured-collection__arrow swiper-button-next" aria-label="{{ 'general.slider.next_slide' | t }}">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
        <path d="M3.3335 8H12.6668M8.66683 12L12.6668 8L8.66683 4" stroke="currentColor" stroke-width="1.33333"/>
      </svg>
    </button>
  </div>
{%- endcapture -%}

{%- capture view_all_button -%}
  <a href="{{ section.settings.collection.url }}" class="button button--{{ section.settings.button_style }} featured-collection__view-all">
    <span class="button--text">{{ section.settings.button_label | escape }}</span>
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M3.3335 8H12.6668M8.66683 12L12.6668 8L8.66683 4" stroke="currentColor" stroke-width="1.33333"/>
    </svg>
  </a>
{%- endcapture -%}

{%- capture product_cards -%}
  {%- if section.settings.collection.products.size > 0 -%}
    {%- assign skip_card_product_styles = false -%}
    {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
      <div
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        class="swiper-slide"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
          style="--animation-order: {{ forloop.index }};"
        {% endif %}
      >
        {% render 'card-product',
          card_product: product,
          media_aspect_ratio: section.settings.image_ratio,
          show_secondary_image: section.settings.show_secondary_image,
          meta_source: section.settings.meta_line,
          show_rating: section.settings.show_rating,
          skip_styles: skip_card_product_styles,
          section_id: section.id,
          quick_add: section.settings.quick_add
        %}
      </div>
      {%- assign skip_card_product_styles = true -%}
    {%- endfor -%}
  {%- else -%}
    {%- for i in (1..section.settings.products_to_show) -%}
      {%- assign ridx = forloop.index0 | modulo: 4 | plus: 1 -%}
      {%- assign placeholder_image = 'product-apparel-' | append: ridx -%}
      <div
        class="swiper-slide"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
          style="--animation-order: {{ forloop.index }};"
        {% endif %}
      >
        {% render 'card-product',
          media_aspect_ratio: section.settings.image_ratio,
          placeholder_image: placeholder_image
        %}
      </div>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient">
  <div
    class="featured-collection section-{{ section.id }}-padding"
    id="collection-{{ section.id }}"
    data-id="{{ section.id }}"
  >
    <div class="{{ section.settings.page_width }}">
      <div class="featured-collection__body">
      {%- if section.settings.subheading != blank or section.settings.heading != blank or show_view_all or show_arrows -%}
        <div class="featured-collection__header">
          <div class="featured-collection__header-text">
            {%- if section.settings.subheading != blank -%}
              <p class="featured-collection__eyebrow sub-heading">{{ section.settings.subheading }}</p>
            {%- endif -%}

            {%- if section.settings.heading != blank -%}
              <h2 class="featured-collection__title inline-richtext {{ section.settings.heading_size }}">
                {{ section.settings.heading }}
              </h2>
            {%- endif -%}
          </div>

          <div class="featured-collection__header-action">
            {%- if is_carousel -%}
              {{ nav_arrows }}
            {%- elsif show_view_all -%}
              {{ view_all_button }}
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <div class="featured-collection__products">
      {%- if is_carousel -%}
        <slideshow-swiper>
          <div
            class="slideshow__swiper swiper product-feed"
            data-centeredslides="false"
            data-slidesDesktop="{{ column }}"
            data-slidesTab="{{ column_medium }}"
            data-slidesMobile="{{ column_mobile }}"
            data-autoPlay="{{ section.settings.autoplay_enabled }}"
            data-delay="{{ delay }}"
            data-loop="{{ section.settings.loop_enabled }}"
            data-paginationType="bullets"
            data-freemode="false"
            data-freemomentum="false"
            data-mousewheel="false"
            data-desktopspace="20"
            data-tabspace="20"
            data-mobilespace="16"
          >
            <div
              id="Slider-{{ section.id }}"
              class="swiper-wrapper product-feed-container"
              role="list"
            >
              {{ product_cards }}
            </div>
          </div>
        </slideshow-swiper>

      {%- elsif is_mobile_carousel -%}
        <mobile-carousel
          data-breakpoint="750"
          data-slidesmobile="{{ column_mobile }}"
          data-mobilespace="16"
        >
          <div class="mobile-carousel__swiper swiper product-feed">
            <div
              id="Slider-{{ section.id }}"
              class="swiper-wrapper product-feed-container featured-collection__grid grid-cols-{{ grid_cols_mobile }} grid-cols-md-{{ column_medium }} grid-cols-lg-{{ column }}"
              role="list"
            >
              {{ product_cards }}
            </div>
          </div>
          {{ nav_arrows }}
        </mobile-carousel>

      {%- else -%}
        <div
          id="Slider-{{ section.id }}"
          class="product-feed-container featured-collection__grid grid-cols-{{ grid_cols_mobile }} grid-cols-md-{{ column_medium }} grid-cols-lg-{{ column }}"
          role="list"
        >
          {{ product_cards }}
        </div>
      {%- endif -%}
      </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container-fluid",
          "label": "Full Width"
        }
      ],
      "default": "container-fluid",
      "label": "Layout Width"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The collection"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Eleven wild herbs.",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "hxl",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured-collection.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured-collection.settings.products_to_show.label"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout",
      "info": "Carousel shows navigation arrows. Grid shows the view all button.",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_carousel",
      "label": "Carousel on mobile",
      "info": "Grid layout only. Below 750px the grid becomes a swipeable carousel.",
      "default": true
    },
    {
      "type": "select",
      "id": "column",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        }
      ],
      "default": "4",
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "column_medium",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "3",
      "label": "Columns on tablet"
    },
    {
      "type": "select",
      "id": "column_mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1",
      "label": "Columns on mobile"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "t:sections.featured-collection.settings.show_view_all.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "View all teas",
      "label": "Button label"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "primary-outline",
          "label": "Primary outline"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "secondary-outline",
          "label": "Secondary outline"
        }
      ],
      "default": "primary",
      "label": "Button style"
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.featured-collection.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.featured-collection.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.featured-collection.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.featured-collection.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "meta_line",
      "label": "Line above the title",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "vendor",
          "label": "Vendor"
        },
        {
          "value": "type",
          "label": "Category"
        }
      ],
      "default": "vendor"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.featured-collection.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": true,
      "label": "t:sections.featured-collection.settings.show_rating.label",
      "info": "t:sections.featured-collection.settings.show_rating.info"
    },
    {
      "type": "select",
      "id": "quick_add",
      "label": "t:sections.featured-collection.settings.quick_add.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.featured-collection.settings.quick_add.options__1.label"
        },
        {
          "value": "standard",
          "label": "t:sections.featured-collection.settings.quick_add.options__2.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "autoplay_enabled",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_timeout",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay interval",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "loop_enabled",
      "label": "Loop",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_swiper",
      "label": "Navigation colors",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 104
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Tab",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Tab",
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 58
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-collection.presets.name"
    }
  ]
}
{% endschema %}
