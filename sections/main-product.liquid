                                                                        </svg>

                                                                  </span>

                                                              </div>

                                                                <div class="review-stars">

                                                              {% for star in (1..5) %}
                                                                  {% if star <= block.settings[rating] %}
                                                                        <span class="star">
                                                                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                    <path d="M14.6431 7.17815L11.8306 9.60502L12.6875 13.2344C12.7347 13.4314 12.7226 13.638 12.6525 13.8281C12.5824 14.0182 12.4575 14.1833 12.2937 14.3025C12.1298 14.4217 11.9343 14.4896 11.7319 14.4977C11.5294 14.5059 11.3291 14.4538 11.1562 14.3481L7.99996 12.4056L4.84184 14.3481C4.66898 14.4532 4.4689 14.5048 4.2668 14.4963C4.06469 14.4879 3.8696 14.4199 3.70609 14.3008C3.54257 14.1817 3.41795 14.0169 3.3479 13.8272C3.27786 13.6374 3.26553 13.4312 3.31246 13.2344L4.17246 9.60502L1.35996 7.17815C1.20702 7.04596 1.09641 6.87166 1.04195 6.67699C0.987486 6.48232 0.99158 6.27592 1.05372 6.08356C1.11586 5.89121 1.23329 5.72142 1.39135 5.59541C1.54941 5.4694 1.7411 5.39274 1.94246 5.37502L5.62996 5.07752L7.05246 1.63502C7.12946 1.44741 7.26051 1.28693 7.42894 1.17398C7.59738 1.06104 7.7956 1.00073 7.9984 1.00073C8.2012 1.00073 8.39942 1.06104 8.56785 1.17398C8.73629 1.28693 8.86734 1.44741 8.94434 1.63502L10.3662 5.07752L14.0537 5.37502C14.2555 5.39208 14.4477 5.46831 14.6064 5.59415C14.765 5.71999 14.883 5.88984 14.9455 6.08243C15.008 6.27502 15.0123 6.48178 14.9579 6.6768C14.9034 6.87182 14.7926 7.04644 14.6393 7.17877L14.6431 7.17815Z" fill="#FFA500"/>
                                                                  </svg>
                                                                </span>
                                                                  {% endif %}
                                                              {% endfor %}

                                                          </div>

                                                            </div>

                                                              <div class="review-date">
                                                                  {{ block.settings[date] }}
                                                              </div>

                                                          </div>

                                                        

                                                          <div class="review-content">
                                                          <p>
                                                              {{ block.settings[text] }}
                                                          </p>
                                                              </div>

                                                        

                                                      </div>

                                                  </div>

                                              {% endif %}

                                          {% endfor %}

                                      </div>

                            <div class="pagination-wrap  color-{{ block.settings.color_scheme_swiper }}">
                              <div class="swiper-pagination"></div>
                            </div>
                                  

                                  </div>
                                            
                    </slideshow-swiper>   
                      </div>    
                                    

                {%- when 'pickup_details' -%}

                  

                  <div class="pickup-container"  {{ block.shopify_attributes }}>

                      <label class="option active">
                          <input type="checkbox" checked>
                          <span class="checkmark"></span>

                          <div class="content">
                              <h4>{{ block.settings.title_1 }}</h4>
                              <p>{{ block.settings.text_1 }}</p>
                          </div>
                      </label>

                      <label class="option">
                          <input type="checkbox">
                          <span class="checkmark"></span>

                          <div class="content">
                              <h4>{{ block.settings.title_2 }}</h4>
                              <p>{{ block.settings.text_2 }}</p>
                          </div>
                      </label>

                  </div>



                {%- when 'scroll_item' -%}

                      <div class="scroll-wrapper running-content marquee color-{{ block.settings.color_scheme }} gradient" {{ block.shopify_attributes }}>

                          <marquee-content
                            data-speed="{{ block.settings.speed }}"
                            class="running-content-wrap"
                            style="--marquee-duration: {{ 1000 | divided_by: block.settings.speed }}s;"
                          >

                            {%- capture marquee_item -%}
                          {% for i in (1..5) %}

                            
                                {%- capture icon_c -%}icon_{{ i }}{%- endcapture -%}
                                  {%- capture title_c -%}title_{{ i }}{%- endcapture -%}
                                  {%- liquid
                                    assign icon = block.settings[icon_c] 
                                    assign title = block.settings[title_c] 
                                  %}

          
                                        {% if icon != blank and title != blank %}
                              <div class="running-content-item running-content-text scroll-item"  >



                                        {% if icon != blank %}
                                          <div class="scroll__icon">
                                            {% render 'icon-img' with image, image: icon %}
                                          </div>
                                        {% endif %}

                                        <div class="scroller__text">
                                          {% if title != blank %}
                                            <span class="scroller__title">{{title }}</span>
                                          {% endif %}
                                      </div>
                          
                              </div>

                    {% endif %}
                          {% endfor %}
                      {%- endcapture -%}

                      <div class="marquee-container js-marquee-items {{ block.settings.pause_when_hover | default: '' | replace: 'true', 'marquee--animation-pause' }}">

                      {%- for i in (1..3) -%}
                          <div class="js-marquee-item marquee-item  marquee__items--animate  marquee--{{- block.settings.moving_direction }}">
                            {{- marquee_item -}}
                          </div>
                        {%- endfor -%}

                      </div>


                          </marquee-content>
                      </div>


                  
                
                {%- when 'variant_picker' -%}
                  {% render 'product-variant-picker',
                    product: product,
                    block: block,
                    product_form_id: product_form_id
                  %}
                {%- when 'buy_buttons' -%}
                  {%- render 'buy-buttons',
                    block: block,
                    product: product,
                    product_form_id: product_form_id,
                    section_id: section.id,
                    show_pickup_availability: true
                  -%}
                {%- when 'rating' -%}
                  {%- if product.metafields.reviews.rating.value != blank -%}
                    {%- liquid
                      assign rating_decimal = 0
                      assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
                      if decimal >= 0.3 and decimal <= 0.7
                        assign rating_decimal = 0.5
                      elsif decimal > 0.7
                        assign rating_decimal = 1
                      endif

                      assign review_count = product.metafields.reviews.rating_count
                      assign review_label = block.settings.reviews_label | default: 'Reviews'
                      if review_count == 1 and block.settings.reviews_label_one != blank
                        assign review_label = block.settings.reviews_label_one
                      endif
                    -%}
                    <div class="rating-wrapper" {{ block.shopify_attributes }}>
                      <div
                        class="rating"
                        role="img"
                        aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
                      >
                        <span
                          aria-hidden="true"
                          class="rating-star"
                          style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
                        ></span>
                      </div>
                      <p class="rating-text caption">
                        <span aria-hidden="true">
                          {{- product.metafields.reviews.rating.value }} /
                          {{ product.metafields.reviews.rating.value.scale_max -}}
                        </span>
                      </p>
                      {%- if block.settings.show_review_count -%}
                        <p class="rating-count">
                          {%- if block.settings.reviews_link != blank -%}
                            <a href="{{ block.settings.reviews_link }}">
                              {{- review_count }} {{ review_label -}}
                            </a>
                          {%- else -%}
                            <span aria-hidden="true">{{ review_count }} {{ review_label }}</span>
                          {%- endif -%}
                          <span class="visually-hidden">
                            {{- review_count }}
                            {{ 'accessibility.total_reviews' | t -}}
                          </span>
                        </p>
                      {%- endif -%}
                    </div>
                  {%- endif -%}


                {%- when 'bundles_products' -%}

             
                  {% assign bundles_products = product.metafields.custom.bundles_products.value %}

                  {% if bundles_products != blank %}
                    <div class="bundles-products">
                      {% if block.settings.title != blank %}
                        <h2 class="bundles-products__title">{{ block.settings.title }}</h2>
                      {% endif %}

                      <div class="bundles-products__wrapper">
                        {% for bundle_product in bundles_products %}
                      
                            {% render "bundle-product" , bundle_product:  bundle_product, section_id:  section.id %}


                        {% endfor %}
                      </div>
                    </div>
                  {% endif %}

                 

                {%- when 'complementary' -%}

 
                  <product-recommendations
                    class="complementary-products quick-add-hidden{% if block.settings.make_collapsible_row %} is-accordion{% endif %}{% if block.settings.enable_quick_add %} complementary-products-contains-quick-add{% endif %}"
                    data-url="{{ routes.product_recommendations_url }}?limit={{ block.settings.product_list_limit }}&intent=complementary"
                    data-section-id="{{ section.id }}"
                    data-product-id="{{ product.id }}"
                  >
 
                    {%- if recommendations.performed and recommendations.products_count > 0 -%}

                       {% liquid
                            assign enable_pagination = block.settings.enable_pagination
                            assign enable_navigation = block.settings.enable_navigation
                            assign enable_scroll = block.settings.enable_scroll
                            assign autoplay = block.settings.autoplay_enabled
                            assign loop = block.settings.loop_enabled
                            assign delay = block.settings.autoplay_timeout | times: 1000
                            assign freemode = false
                          %}


                      <aside
                        aria-label="{{ 'accessibility.complementary_products' | t }}"
                        {{ block.shopify_attributes -}}
                        {% if block.settings.make_collapsible_row %}
                          class="product__accordion accordion"
                        {% endif %}
                      >
                         <slideshow-swiper> 
                        <div class="complementary-products__container">
                          {%- if block.settings.make_collapsible_row -%}
                            <details id="Details-{{ block.id }}-{{ section.id }}" open>
                              <summary>
                          {%- endif %}
                          <div class="summary__title">
                            

                          <div class="accordion-header-inner">
                            {%- if block.settings.make_collapsible_row -%}
                              {% render 'icon-accordion', icon: block.settings.icon %}
                              <h2 class="h4 accordion__title">{{ block.settings.block_heading }}</h2>
                            {%- else -%}
                              <h2 class="h3 accordion__title">{{ block.settings.block_heading }}</h2>
                            {%- endif -%}
                          </div>


                             {% if enable_pagination %}
                                  <div class="pagination-wrap color-{{ section.settings.color_scheme_swiper }}">
                                    <div class="swiper-pagination"></div>
                                  </div>
                                {% endif %}


                          </div>
                          {%- if block.settings.make_collapsible_row -%}
                            {{- 'icon-caret.svg' | inline_asset_content -}}
                            </summary>
                          {%- endif -%}

                         

                          
                            {%- assign number_of_slides = recommendations.products_count
                              | plus: 0.0
                              | divided_by: block.settings.products_per_page
                              | ceil
                            -%}

                            <div
                              id="Slider-{{ block.id }}"
                              class="contains-card contains-card--product complementary-slider"
                              role="list"
                              {% if number_of_slides > 1 %}
                                aria-label="{{ 'general.slider.name' | t }}"
                              {% endif %}
                            >
                              {% assign skip_card_product_styles = false %}

                              <div
                                id="Slide-{{ block.id }}-{{ forloop.index }}"
                                class="slideshow__swiper swiper product-feed complementary-slide complementary-slide--{{ settings.card_style }} "
                                tabindex="-1"
                                role="group"

                                data-centeredslides="false"
                                data-slidesDesktop="3"
                                data-slidesTab="2"
                                data-slidesMobile="1.75"
                                data-autoPlay="{{ autoplay }}"
                                data-delay="{{ delay }}"
                                data-loop="{{ loop }}"
                                data-paginationType="bullets"
                                data-freemode="{{ freemode }}"
                                data-freemomentum="false"
                                data-mousewheel="false"
                                data-desktopspace="15"
                                data-tabspace="15"
                                data-mobilespace="15"

                                {% if number_of_slides > 1 %}
                                  aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                                  aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                                {% endif %}
                              >
                                <div
                                  class="list-unstyled swiper-wrapper product-feed-container row row-cols-2"
                                  role="list"
                                >
                                  {%- for product in recommendations.products
                                    limit: block.settings.products_per_page
                                  -%}
                                    <div class="swiper-slide col">
                                      {%- if block.settings.enable_quick_add -%}
                                        {% assign quick_add = 'standard' %}
                                      {%- else -%}
                                        {% assign quick_add = 'none' %}
                                      {%- endif -%}
                                      {% render 'card-product',
                                        card_product: product,
                                        media_aspect_ratio: block.settings.image_ratio,
                                        show_secondary_image: false,
                                        lazy_load: false,
                                        skip_styles: skip_card_product_styles,
                                        quick_add: quick_add,
                                        add_button_style: 'text',
                                        section_id: section.id,
                                        horizontal_class: false,
                                        horizontal_quick_add: false,
                                        badge: false,
                                        siblings: false
                                      %}
                                    </div>
                                    {%- assign skip_card_product_styles = true -%}
                                  {%- endfor -%}
                                </div>

                                {% if enable_navigation %}
                                  <div class="swiper-navigation-wrapper color-{{ section.settings.color_scheme_swiper }}">
                                    <div class="swiper-button-prev">
                                      <svg
                                        width="15"
                                        height="26"
                                        viewBox="0 0 15 26"
                                        fill="none"
                                        xmlns="http://www.w3.org/2000/svg"
                                      >
                                        <path d="M1.76123 13.1011L12.7612 24.1011" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M12.7612 2.10107L1.76123 13.1011" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                      </svg>
                                    </div>
                                    <div class="swiper-button-next">
                                      <svg
                                        width="15"
                                        height="26"
                                        viewBox="0 0 15 26"
                                        fill="none"
                                        xmlns="http://www.w3.org/2000/svg"
                                      >
                                        <path d="M13.2388 12.8989L2.23877 1.89893" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M2.23877 23.8989L13.2388 12.8989" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                      </svg>
                                    </div>
                                  </div>
                                {% endif %}
                               

                                {% if enable_scroll %}
                                  <div class="scrollbar-wrap color-{{ section.settings.color_scheme_swiper }}">
                                    <div class="swiper-scrollbar"></div>
                                  </div>
                                {% endif %}
                              </div>
                            </div>
                       

                          {%- if block.settings.make_collapsible_row -%}
                            </details>
                          {%- endif -%}
                        </div>
                        </slideshow-swiper>


                      </aside>
                    {%- endif -%}
                    {{ 'component-card.css' | asset_url | stylesheet_tag }}
                    {{ 'component-complementary-products.css' | asset_url | stylesheet_tag }}
                    {%- if block.settings.enable_quick_add -%}
                      {{ 'quick-add.css' | asset_url | stylesheet_tag }}
                      <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
                    {%- endif -%}
                  </product-recommendations>
                {%- when 'subtitle' -%}
                  {%- if block.settings.text != blank -%}
                    <div class="product__subtitle" {{ block.shopify_attributes }}>
                      {{ block.settings.text }}
                    </div>
                  {%- endif -%}

                {%- when 'quote_card' -%}
                  {%- if block.settings.text != blank -%}
                    <div class="product__quote" {{ block.shopify_attributes }}>
                      {%- if block.settings.show_icon -%}
                        <span class="product__quote-figure">
                          {%- if block.settings.image != blank -%}
                            <img
                              src="{{ block.settings.image | image_url: width: 240 }}"
                              alt="{{ block.settings.image.alt | escape }}"
                              width="{{ block.settings.image.width }}"
                              height="{{ block.settings.image.height }}"
                              loading="lazy"
                            >
                          {%- else -%}
                            {{- 'icon-quote-sprig.svg' | inline_asset_content -}}
                          {%- endif -%}
                        </span>
                      {%- endif -%}
                      <div class="product__quote-text">{{ block.settings.text }}</div>
                    </div>
                  {%- endif -%}

                {%- when 'certifications' -%}
                  {%- liquid
                    assign certification_indexes = '1,2,3,4,5,6' | split: ','
                    assign certification_count = 0
                    for i in certification_indexes
                      assign label_key = 'label_' | append: i
                      if block.settings[label_key] != blank
                        assign certification_count = certification_count | plus: 1
                      endif
                    endfor
                  -%}
                  {%- if certification_count > 0 -%}
                    <ul
                      class="product__certifications list-unstyled"
                      role="list"
                      style="--certification-columns: {{ certification_count | at_most: 5 }};"
                      {{ block.shopify_attributes }}
                    >
                      {%- for i in certification_indexes -%}
                        {%- liquid
                          assign label_key = 'label_' | append: i
                          assign image_key = 'image_' | append: i
                          assign certification_label = block.settings[label_key]
                          assign certification_image = block.settings[image_key]
                        -%}
                        {%- if certification_label != blank -%}
                          <li class="product__certification">
                            <span class="product__certification-icon">
                              {%- if certification_image != blank -%}
                                {{
                                  certification_image
                                  | image_url: width: 200
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '50, 100, 150, 200',
                                    class: 'product__certification-image',
                                    alt: certification_label
                                }}
                              {%- else -%}
                                {%- render 'icon-check-circle', style: 'outline', size: 28 -%}
                              {%- endif -%}
                            </span>
                            <span class="product__certification-label">{{ certification_label }}</span>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}

                {%- when 'guarantee_row' -%}
                  {%- liquid
                    assign guarantees = ''
                    for i in (1..3)
                      assign guarantee_key = 'text_' | append: i
                      if block.settings[guarantee_key] != blank
                        assign guarantees = guarantees | append: block.settings[guarantee_key] | append: '~~'
                      endif
                    endfor
                    assign guarantees = guarantees | split: '~~'
                  -%}
                  {%- if guarantees.size > 0 -%}
                    <ul class="product__guarantees list-unstyled" role="list" {{ block.shopify_attributes }}>
                      {%- for guarantee in guarantees -%}
                        <li class="product__guarantee">
                          {%- render 'icon-check-circle', style: 'outline', size: 18 -%}
                          <span>{{ guarantee }}</span>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}


                {%- when 'icon-with-text' -%}
                  {% render 'icon-with-text', block: block %}
              {%- endcase -%}
            {%- endfor -%}
          </section>
        </div>
      </div>

      {% render 'product-media-modal', variant_images: variant_images %}

      {% assign popups = section.blocks | where: 'type', 'popup' %}
      {%- for block in popups -%}
        <modal-dialog id="PopupModal-{{ block.id }}" class="product-popup-modal" {{ block.shopify_attributes }}>
          <div
            role="dialog"
            aria-label="{{ block.settings.text }}"
            aria-modal="true"
            class="product-popup-modal__content"
            tabindex="-1"
          >
            <button
              id="ModalClose-{{ block.id }}"
              type="button"
              class="product-popup-modal__toggle"
              aria-label="{{ 'accessibility.close' | t }}"
            >
              {{- 'icon-close.svg' | inline_asset_content -}}
            </button>
            <div class="product-popup-modal__content-info">
              <h1 class="h2">{{ block.settings.page.title | escape }}</h1>
              {{ block.settings.page.content }}
            </div>
          </div>
        </modal-dialog>
      {%- endfor -%}

      {% assign size_chart = product.metafields.custom.size_chart.value %}

      {% if size_chart != blank %}
        <modal-dialog id="PopupModal-popup_size_chart" class="product-popup-modal" data-section="{{ section.id }}">
          <div
            role="dialog"
            aria-label="Lien texte pop-up"
            aria-modal="true"
            class="product-popup-modal__content"
            tabindex="-1"
          >
            <button
              id="ModalClose-popup_size_chart"
              type="button"
              class="product-popup-modal__toggle"
              aria-label="Fermer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon icon-close" viewBox="0 0 18 17">
                <path fill="currentColor" d="M.865 15.978a.5.5 0 0 0 .707.707l7.433-7.431 7.579 7.282a.501.501 0 0 0 .846-.37.5.5 0 0 0-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 1 0-.707-.708L8.991 7.853 1.413.573a.5.5 0 1 0-.693.72l7.563 7.268z"></path>
              </svg>
            </button>
            <div class="product-popup-modal__content-info">
              <h1 class="h2  size-chart-header">Size Chart</h1>

              <div class="size-chart-wrapper">
                {% if size_chart != blank %}
                  {% render 'responsive-img' with image, image: size_chart %}
                {% endif %}
              </div>
            </div>
          </div>
        </modal-dialog>
      {% endif %}

      {% assign payement_secure = section.blocks | where: 'type', 'payement_secure' %}
      {%- for block in payement_secure -%}
        <div id="paymenticons" class="paymentpopup" style="display: none;">
          <div class="payments">
            <span>{{ block.settings.payments_text }}</span>

            {% if shop.enabled_payment_types != blank %}
              <div class="footer__payment">
                <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
                <ul class="list list-payment" role="list">
                  {%- for type in shop.enabled_payment_types -%}
                    <li class="list-payment__item">
                      {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {% else %}
              <div class="footer__payment">
                <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
                {% render 'payment-icon' %}
              </div>
            {% endif %}

            <button id="close" class="button button--primary button--close">CLOSE</button>
          </div>
        </div>
      {%- endfor -%}

      {%- if product.media.size > 0 -%}
        <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
        <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
      {%- endif -%}

      {%- if first_3d_model -%}
        <script type="application/json" id="ProductJSON-{{ product.id }}">
          {{ product.media | where: 'media_type', 'model' | json }}
        </script>
        <script src="{{ 'product-model.js' | asset_url }}" defer></script>
      {%- endif -%}

      {%- liquid
        if product.selected_or_first_available_variant.featured_media
          assign seo_media = product.selected_or_first_available_variant.featured_media
        else
          assign seo_media = product.featured_media
        endif
      -%}

      <script type="application/ld+json">
        {{ product | structured_data }}
      </script>
    </div>
  </div>
</product-info>

<script>
  const pushHandleToRecentProducts = () => {
    const handles = localStorage.getItem('recently-viewed');

    if (!handles) {
      localStorage.setItem('recently-viewed', '{{- product.handle -}}');
      return;
    }

    if (handles.includes('{{- product.handle -}}')) return;

    const handlesToAdd = ['{{- product.handle -}}', ...handles.split(',')];

    if (handlesToAdd.length > 10) {
      handlesToAdd.pop();
    }

    localStorage.setItem('recently-viewed', handlesToAdd.join(','));
  };

  pushHandleToRecentProducts();
</script>

<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {% if seo_media -%}
      "image": [
        {{ seo_media | image_url: width: seo_media.preview_image.width | prepend: "https:" | json }}
      ],
    {%- endif %}
    "description": {{ product.description | strip_html | json }},
    {% if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif %}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          {%- if variant.barcode.size == 12 -%}
            "gtin12": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 13 -%}
            "gtin13": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 14 -%}
            "gtin14": {{ variant.barcode }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "url" : {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

