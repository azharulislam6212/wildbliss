{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'component-product-purchase-options.css' | asset_url | stylesheet_tag }}
{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'marquee.css' | asset_url | stylesheet_tag }}

{% unless product.has_only_default_variant %}
  {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
  {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
  {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
{% endunless %}
{%- if product.quantity_price_breaks_configured? -%}
  {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
         --color-accent: {{ section.settings.color_accent.red }},{{ section.settings.color_accent.green }},{{ section.settings.color_accent.blue }};
         --color-link: {{ section.settings.color_accent.red }},{{ section.settings.color_accent.green }},{{ section.settings.color_accent.blue }};
         --pdp-badge: {{ section.settings.color_badge }};
         --pdp-tag-highlight: {{ section.settings.color_tag_highlight }};
         --pdp-tag-color: {{ section.settings.color_tag_text }};
         --pdp-highlight: {{ section.settings.color_highlight }};
         --pdp-soft-surface: {{ section.settings.color_soft_surface }};
       }

     .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile}}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- if product.quantity_price_breaks_configured? -%}
  <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

 
 

<product-info
  id="MainProduct-{{ section.id }}"
  class="product-wrapper section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}  {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {%- liquid
    if product == null
      assign placeholder = true
    endif

    assign first_3d_model = product.media | where: 'media_type', 'model'

    capture section_class
      echo 'product--gallery-type-' | append: section.settings.gallery_type | append: ' product--gallery-size-' | append: section.settings.gallery_image_size | append: ' ' | append: class
    endcapture

    if section.settings.gallery_size == '8'
      assign grid_left = 'col-lg-7 col-xl-8'
      assign grid_right = 'col-lg-5 col-xl-4'
    elsif section.settings.gallery_size == '7'
      assign grid_left = 'col-md-7'
      assign grid_right = 'col-md-5'
    elsif section.settings.gallery_size == '6'
      assign grid_left = 'col-md-6'
      assign grid_right = 'col-md-6'
    elsif section.settings.gallery_size == '5'
      assign grid_left = 'col-md-5'
      assign grid_right = 'col-md-7'
    else
      assign grid_left = 'col-md-6'
      assign grid_right = 'col-md-6'
    endif
  -%}

  {%- if first_3d_model -%}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{- 'component-model-viewer-ui.css' | asset_url -}}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {%- if product.media.size > 0 -%}
    {%- if section.settings.enable_zoom -%}
      <link rel="stylesheet" href="{{- 'photoswipe.css' | asset_url -}}" media="print" onload="this.media='all'">

      <script src="{{- 'photoswipe-lightbox.umd.min.js' | asset_url -}}" defer="defer" data-theme-script></script>
      <script src="{{- 'photoswipe.umd.min.js' | asset_url -}}" defer="defer" data-theme-script></script>
    {%- endif -%}

    <script src="{{- 'product-popup.js' | asset_url -}}" defer="defer" data-theme-script></script>
    <script src="{{- 'product-media.js' | asset_url -}}" defer="defer" data-theme-script></script>
  {%- endif -%}

  {%- capture thumbs_html -%}
    <div class="product__media-thumbs  {%- unless section.settings.gallery_type contains 'thumbs' %}   large-up-hide  {%- endunless -%}  {%- if section.settings.enable_mobile_thumbs == false %}  small-hide    medium-hide {%- endif -%}">
      <div class="swiper" data-thumbs>
        <div class="swiper-wrapper {%if  section.settings.gallery_type == 'thumbs-bottom'%} row-cols-5 {%- endif -%}">
          {%- for media in product.media -%}
          
  
            <div
              class="swiper-slide  {%if  section.settings.gallery_type == 'thumbs-bottom'%} col {%- endif -%}"
              data-thumbnail
            >
              {%- render 'product-thumbnail-custom', media: media, media_size: section.settings.gallery_image_size -%}
            </div>
          {%- endfor -%}
        </div>
        <div class="product__media-thumbs-arrows">
          {%- comment -%}
            Same arrow glyph as the main gallery and the home carousel. The
            vertical thumb layouts rotate it in CSS, so one icon covers both.
          {%- endcomment -%}
          <button class="button-arrow button-arrow--small product__media-thumbs-arrow product__media-thumbs-arrow--prev" data-thumbs-prev aria-label="previous">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path d="M12.6668 8H3.3335M7.3335 12L3.3335 8L7.3335 4" stroke="currentColor" stroke-width="1.33333"/>
            </svg>
          </button>

          <button class="button-arrow button-arrow--small product__media-thumbs-arrow product__media-thumbs-arrow--next" data-thumbs-next aria-label="next">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path d="M3.3335 8H12.6668M8.66683 12L12.6668 8L8.66683 4" stroke="currentColor" stroke-width="1.33333"/>
            </svg>
          </button>
        </div><!-- /.product__media-thumbs-arrows -->
      </div>
    </div><!-- /.product__media-thumbs -->
  {%- endcapture -%}


  {%- style -%}
    #MainProduct-{{- section.id }} {
      {%- liquid
        assign partial_slide_ratio = 0.9
        assign slide_width = 100.0 | divided_by: section.settings.slides_per_view
        if section.settings.partial_slide
          assign slide_width = slide_width | times: partial_slide_ratio
        endif
      -%}

      --slide-width: {{ slide_width }}%;
    }
  {%- endstyle -%}
  

 
  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <div class="product-block__wrapper  product {{ section_class }} js-main-product" id="MainProduct-{{- section.id }}">
    <div class="{{ section.settings.page_width }}">
      <div class="row product-row {% if section.settings.layout == 'text_first' %} flex-row-reverse {% endif %}">
        <div class="col-12  {{grid_left}}  {%if section.settings.enable_sticky_gallery %} product__gallery-sticky {% endif %}">
          {%- unless placeholder -%}
            <div class="product-gallery__wrapper">
              <product-media
                class="product__media"
                {% if section.settings.gallery_image_size == 'aspect-ratio' %}
                  data-slider-autoheight
                {% endif %}
                {% if section.settings.gallery_type contains 'grid' %}
                  data-slider-desktop-disabled
                {%- elsif section.settings.gallery_type != 'thumbs-bottom' -%}
                  data-thumbs-layout="{{- section.settings.gallery_type | remove: 'thumbs-' -}}"
                {% endif %}
                data-thumbs-per-view="{{ section.settings.thumbs_per_view }}"
                data-thumbs-per-view-mobile="{{ section.settings.thumbs_per_view_mobile }}"
              >
                {%- if product.media.size > 1 -%}
                  {%- if section.settings.gallery_type == 'thumbs-left' -%}
                    {{- thumbs_html -}}
                  {%- endif -%}

                  <div class="product__media-slider">
                    <div class="swiper product__swiper" data-slider>
                      <div class="product__media-track swiper-wrapper">
                        {%- for media in product.media -%}
                          <div
                            class="product__media-slide swiper-slide"
                            data-media-item
                            data-media-id="{{- media.id -}}"
                            data-index="{{- forloop.index0 -}}"
                            {%- if product.selected_or_first_available_variant.featured_media.id == media.id %}
                              data-selected
                            {%- endif %}
                          >
                            {%- render 'product-media-custom',
                              media: media,
                              product_ref: product,
                              preload_media: forloop.first,
                              media_size: section.settings.gallery_image_size,
                              disable_zoom_icon: section.settings.disable_zoom_icon,
                              enable_zoom: section.settings.enable_zoom
                            -%}
                          </div>
                          <!-- /.product__media-slide -->
                        {%- endfor -%}
                      </div>
                      <!-- /.product__media-track -->

                      {%- if section.settings.enable_navigation -%}
                        <div class="swiper-navigation product__media-nav">
                          <button
                            class="product__media-arrow button-arrow motion-reduce"
                            data-arrow-prev
                            aria-label="previous"
                          >
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                              <path d="M12.6668 8H3.3335M7.3335 12L3.3335 8L7.3335 4" stroke="currentColor" stroke-width="1.33333"/>
                            </svg>
                          </button>

                          <button
                            class="product__media-arrow button-arrow motion-reduce"
                            data-arrow-next
                            aria-label="next"
                          >
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                              <path d="M3.3335 8H12.6668M8.66683 12L12.6668 8L8.66683 4" stroke="currentColor" stroke-width="1.33333"/>
                            </svg>
                          </button>
                        </div>
                        <!-- /.swiper-navigation -->
                      {%- endif -%}

                      <div class="swiper-pagination"></div>
                    </div>
                  </div>
                  <!-- /.product__media-slider -->


                  {%- if section.settings.gallery_type == 'thumbs-bottom'
                    or section.settings.gallery_type == 'thumbs-right'
                  -%}
                    {{- thumbs_html -}}
                  {%- endif -%}

                  {%- unless section.settings.gallery_type contains 'thumbs'
                    or section.settings.enable_mobile_thumbs == false
                  -%}
                    {{- thumbs_html -}}
                  {%- endunless -%}

                {%- else -%}
                  <div class="product__media-slider">
                    {%- render 'product-media-custom',
                      media: product.featured_media,
                      product_ref: product,
                      media_size: section.settings.gallery_image_size,
                      disable_zoom_icon: section.settings.disable_zoom_icon,
                      enable_zoom: section.settings.enable_zoom
                    -%}
                  </div>
                  <!-- /.product__media-slider -->
                {%- endif -%}
              </product-media>
            </div>
          {%- else -%}
            <div class="product__media-item">
              <div
                class="product-media-container global-media-settings gradient{% if section.settings.constrain_to_viewport %} constrain-height{% endif %}"
                style="--ratio: 1.0; --preview-ratio: 1.0;"
              >
                {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            </div>
          {%- endunless -%}

          {% assign free_trial = section.blocks | where: 'type', 'free_trial' %}
          {%- for block in free_trial -%}
            <div class="free-trial-flex free-trial-desktop" {{ block.shopify_attributes }}>
              {% if block.settings.trial_icon != blank %}
                <span class="trial__icon">
                  {% render 'icon-img' with image, image: block.settings.trial_icon %}
                </span>
              {% endif %}
              <div>
                {% if block.settings.title %}
                  <h3 class="trial__title">{{ block.settings.title }}</h3>
                {% endif %}

                <p class="trial_text">{{ block.settings.text }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>
        <div class="col-12 {{ grid_right }}">
          <section
            id="ProductInfo-{{ section.id }}"
            class="product__info-container {% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}"
          >
            {%- assign product_form_id = 'product-form-' | append: section.id -%}

            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  {% render block %}
                {%- when 'tags' -%}
                  {%- liquid
                    assign product_tags = ''
                    if block.settings.tag_1 != blank
                      assign product_tags = product_tags | append: block.settings.tag_1 | append: '~~'
                    endif
                    if block.settings.tag_2 != blank
                      assign product_tags = product_tags | append: block.settings.tag_2 | append: '~~'
                    endif
                    if block.settings.tag_3 != blank
                      assign product_tags = product_tags | append: block.settings.tag_3 | append: '~~'
                    endif
                    assign product_tags = product_tags | split: '~~'
                  -%}
                  {%- if product_tags.size > 0 -%}
                    <ul class="tag-list list-unstyled" role="list" {{ block.shopify_attributes }}>
                      {%- for product_tag in product_tags -%}
                        <li><span class="product-tag">{{ product_tag }}</span></li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}

                {%- when 'vendor' -%}
                  <p
                    class="product__text-vendor inline-richtext{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.text -}}
                  </p>

                {%- when 'product_description' -%}
                  {% if block.settings.text != blank %}
                    <div
                      class="product__description inline-richtext {% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {{- block.settings.text -}}
                    </div>
                  {% endif %}

                {%- when 'free_trial' -%}
                  <div class="free-trial-flex free-trial-mobile" {{ block.shopify_attributes }}>
                    {% if block.settings.trial_icon != blank %}
                      <span class="trial__icon">
                        {% render 'icon-img' with image, image: block.settings.trial_icon %}
                      </span>
                    {% endif %}
                    <div>
                      {% if block.settings.title %}
                        <h3 class="trial__title">{{ block.settings.title }}</h3>
                      {% endif %}

                      <p class="trial_text">{{ block.settings.text }}</p>
                    </div>
                  </div>
                {%- when 'author' -%}
                  <div class="author__box" {{ block.shopify_attributes }}>
                    {% if block.settings.author_img != blank %}
                      <span class="author__box__image">
                        {% render 'responsive-img' with image, image: block.settings.author_img %}
                      </span>
                    {% endif %}
                    <div>
                      {% if block.settings.title %}
                        <h3 class="author__box__title">{{ block.settings.title }}</h3>
                      {% endif %}

                      <p class="author__box__text">{{ block.settings.text }}</p>
                      <p class="author__box__name">{{ block.settings.author_author }}</p>
                    </div>
                  </div>

                {%- when 'text' -%}
                  <p
                    class="product__text inline-richtext {% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.text -}}
                  </p>
                {%- when 'trust_pilot_review' -%}
                  <div class="trustpilot-review" {{ block.shopify_attributes }}>
                    {% if block.settings.review_icon != blank %}
                      <span class="trustpilot__icon">
                        {% render 'icon-img' with image, image: block.settings.review_icon %}
                      </span>
                    {% endif %}
                    <span>
                      {{ block.settings.text }}
                    </span>
                  </div>

                {%- when 'subscription' -%}
                  {%- render 'product-purchase-options',
                    product: product,
                    block: block,
                    section_id: section.id
                  -%}

                  {%- style -%}
                    .sealsubs-target-element.sealsubs-full[data-seal-ac],
                    .sealsubs-target-element.sealsubs-full[data-seal-in] {
                      display: none !important;
                    }
                  {%- endstyle -%}

                {%- when 'payement_secure' -%}
                  <div class="payement_secure_wrapp">
                    {% if shop.enabled_payment_types != blank and block.settings.enable_custom_payment_icon == false %}
                      <div class="payment-list">
                        <span class="payment-list-payment-title"> {{ block.settings.payment__title  }}</span>
                        <ul class="list list-payment" role="list">
                          {%- for type in shop.enabled_payment_types -%}
                            <li class="list-payment__item">
                              {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    {% else %}
                      <div class="payment-list">
                        <span class="payment-list-payment-title"> {{ block.settings.payment__title }} </span>
                        {% render 'payment-icon' %}
                      </div>
                    {% endif %}
                  </div>

                {%- when 'title' -%}
               
                  <div class="product__title" {{ block.shopify_attributes }}>
                    <h1>{{ product.title | escape }}</h1>
                    <a href="{{ product.url }}" class="product__title">
                      <h2 class="h1">
                        {{ product.title | escape }}
                      </h2>
                    </a>

                  </div>
                {%- when 'price' -%}
                  {%- liquid
                    comment
                      Default to hiding the code: only an explicit tick shows it,
                      so a missing or stale block setting can never bring it back.
                    endcomment
                    assign hide_price_currency_code = true
                    if block.settings.show_currency_code
                      assign hide_price_currency_code = false
                    endif
                  -%}
                  <div id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                    {%- render 'price',
                      product: product,
                      use_variant: true,
                      show_badges: false,
                      show_save: true,
                      price_class: 'price--large',
                      hide_currency_code: hide_price_currency_code
                    -%}
                  </div>
                  {%- if product.quantity_price_breaks_configured? -%}
                    <div class="volume-pricing-note" id="Volume-Note-{{ section.id }}">
                      <span>{{ 'products.product.volume_pricing.note' | t }}</span>
                    </div>
                  {%- endif -%}
                  {%- if block.settings.price_note != blank -%}
                    <p class="product__price-note">{{ block.settings.price_note }}</p>
                  {%- endif -%}

                  {% comment %} <div class="installment-form" {{ block.shopify_attributes }}>
                    {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                    {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-small' -%}
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      {{ form | payment_terms }}
                    {%- endform -%}
                  </div> {% endcomment %}

                {%- when 'inventory' -%}
                  {%- liquid
                    assign inventory_variant = product.selected_or_first_available_variant
                    assign inventory_tracked = false
                    if inventory_variant.inventory_management == 'shopify'
                      assign inventory_tracked = true
                    endif
                    assign stock = inventory_variant.inventory_quantity

                    assign inventory_state = 'unavailable'
                    if inventory_tracked
                      if stock > 0
                        if stock <= block.settings.inventory_threshold
                          assign inventory_state = 'low'
                        else
                          assign inventory_state = 'available'
                        endif
                      elsif inventory_variant.inventory_policy == 'continue'
                        assign inventory_state = 'available'
                      else
                        assign inventory_state = 'unavailable'
                      endif
                    endif
                  -%}
                  <div
                    class="product__inventory product__inventory--{{ inventory_state }}{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% unless inventory_tracked %} visibility-hidden{% endunless %}"
                    {{ block.shopify_attributes }}
                    id="Inventory-{{ section.id }}"
                    role="status"
                  >
                    {%- if inventory_tracked -%}
                      <span class="product__inventory-status">
                        <span class="product__inventory-icon">
                          {%- if inventory_state == 'unavailable' -%}
                            {%- render 'icon-check-circle', style: 'outline', size: 20 -%}
                          {%- else -%}
                            {%- render 'icon-check-circle', style: 'filled', size: 20 -%}
                          {%- endif -%}
                        </span>
                        <span class="product__inventory-text">
                          {%- if inventory_state == 'low' -%}
                            {%- if block.settings.show_inventory_quantity -%}
                              {{- 'products.product.inventory_low_stock_show_count' | t: quantity: stock -}}
                            {%- else -%}
                              {{- 'products.product.inventory_low_stock' | t -}}
                            {%- endif -%}
                          {%- elsif inventory_state == 'available' -%}
                            {%- if block.settings.available_text != blank -%}
                              {{- block.settings.available_text -}}
                            {%- elsif block.settings.show_inventory_quantity and stock > 0 -%}
                              {{- 'products.product.inventory_in_stock_show_count' | t: quantity: stock -}}
                            {%- elsif stock > 0 -%}
                              {{- 'products.product.inventory_in_stock' | t -}}
                            {%- else -%}
                              {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                            {%- endif -%}
                          {%- else -%}
                            {{- 'products.product.inventory_out_of_stock' | t -}}
                          {%- endif -%}
                        </span>
                      </span>

                      {%- if block.settings.secondary_text != blank and inventory_state != 'unavailable' -%}
                        {%- assign secondary_text = block.settings.secondary_text | replace: '[quantity]', stock -%}
                        <span class="product__inventory-note">
                          <svg width="6" height="6" viewBox="0 0 6 6" fill="none" aria-hidden="true" focusable="false">
                            <circle cx="3" cy="3" r="3" fill="currentColor"/>
                          </svg>
                          <span>{{ secondary_text }}</span>
                        </span>
                      {%- endif -%}
                    {%- endif -%}
                  </div>


                {%- when 'description' -%}
                  {%- if product.description != blank -%}
                    <div class="product__description rte quick-add-hidden" {{ block.shopify_attributes }}>
                      {{ product.description }}
                    </div>
                  {%- endif -%}
                {%- when 'feaured_list_text' -%}
                  {%- if block.settings.text != blank -%}
                    <div class="feaured-list-text  quick-add-hidden" {{ block.shopify_attributes }}>
                      {{ block.settings.text }}
                    </div>
                  {%- endif -%}
                {%- when 'sku' -%}
                  <p
                    class="product__sku{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.sku.size == 0 %} visibility-hidden{% endif %}"
                    id="Sku-{{ section.id }}"
                    role="status"
                    {{ block.shopify_attributes }}
                  >
                    <span>{{ 'products.product.sku' | t }}:</span>
                    {{- product.selected_or_first_available_variant.sku -}}
                  </p>
                {%- when 'shipping' -%}
                  <div class="shipping-text" {{ block.shopify_attributes }}>
                    {% if block.settings.shipping_icon != blank %}
                      <span class="shipping__icon">
                        {{ block.settings.shipping_icon }}
                      </span>
                    {% endif %}
                    <span>
                      {{ block.settings.text }}
                    </span>
                  </div>
                {%- when 'custom_liquid' -%}
                  {{ block.settings.custom_liquid }}
                {%- when 'collapsible_tab' -%}
                  {%- liquid
                    assign tab_heading = block.settings.heading | default: block.settings.page.title
                    assign tab_content = block.settings.content | default: block.settings.page.content
                  -%}
                  {%- if tab_heading != blank or tab_content != blank -%}
                    <collapsible-content
                      class="product__accordion quick-add-hidden"
                      {{ block.shopify_attributes }}
                    >
                      <details
                        class="disclosure disclosure--{{ section.settings.accordion_style }}"
                        id="Details-{{ block.id }}-{{ section.id }}"
                        {% if block.settings.open_by_default %}
                          open
                        {% endif %}
                      >
                        <summary>
                          <div class="disclosure-header">
                            <h2 class="disclosure__title inline-richtext">
                              {%- if block.settings.icon_image != blank -%}
                                <span class="accordion__icon">
                                  {% render 'icon-img' with image, image: block.settings.icon_image %}
                                </span>
                              {%- elsif block.settings.icon != 'none' -%}
                                {% render 'icon-accordion', icon: block.settings.icon %}
                              {%- endif -%}
                              {{ tab_heading }}
                            </h2>
                            <span class="disclosure__toggle">
                              <svg
                                class="icon icon-plus"
                                width="16"
                                height="16"
                                viewBox="0 0 16 16"
                                fill="none"
                                aria-hidden="true"
                                focusable="false"
                              >
                                <path d="M8 1.5v13M1.5 8h13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                              </svg>
                            </span>
                          </div>
                        </summary>
                        <div class="disclosure__panel has-motion">
                          <div
                            class="accordion__content disclosure__content rte"
                            id="ProductAccordion-{{ block.id }}-{{ section.id }}"
                          >
                            {{ block.settings.content }}
                            {{ block.settings.page.content }}
                          </div>
                        </div>
                      </details>
                    </collapsible-content>
                  {%- endif -%}


                {%- when 'quantity_selector' -%}
                  <div
                    id="Quantity-Form-{{ section.id }}"
                    class="product-form__input product-form__quantity{% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_vertical_offset < 0 %} product-form__quantity-top{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {%- assign cart_qty = cart
                      | item_count_for_variant: product.selected_or_first_available_variant.id
                    -%}

                    <label class="quantity__label form__label" for="Quantity-{{ section.id }}">
                      {{ 'products.product.quantity.label' | t }}
                      <span class="quantity__rules-cart{% if cart_qty == 0 %} hidden{% endif %}">
                        {%- render 'loading-spinner' -%}
                        <span
                          >(
                          {{- 'products.product.quantity.in_cart_html' | t: quantity: cart_qty -}}
                          )</span
                        >
                      </span>
                    </label>
                    <div class="price-per-item__container">
                      <quantity-input class="quantity" data-url="{{ product.url }}" data-section="{{ section.id }}">
                        <button class="quantity__button" name="minus" type="button">
                          <span class="visually-hidden">
                            {{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}
                          </span>
                          <span class="svg-wrapper">
                            {{- 'icon-minus.svg' | inline_asset_content -}}
                          </span>
                        </button>
                        <input
                          class="quantity__input"
                          type="number"
                          name="quantity"
                          id="Quantity-{{ section.id }}"
                          data-cart-quantity="{{ cart_qty }}"
                          data-min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                          min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                          {% if product.selected_or_first_available_variant.quantity_rule.max != null %}
                            data-max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                            max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                          {% endif %}
                          step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
                          value="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                          form="{{ product_form_id }}"
                        >
                        <button class="quantity__button" name="plus" type="button">
                          <span class="visually-hidden">
                            {{- 'products.product.quantity.increase' | t: product: product.title | escape -}}
                          </span>
                          <span class="svg-wrapper">
                            {{- 'icon-plus.svg' | inline_asset_content -}}
                          </span>
                        </button>
                      </quantity-input>
                      {%- liquid
                        assign volume_pricing_array = product.selected_or_first_available_variant.quantity_price_breaks | sort: 'quantity' | reverse
                        assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.min
                        if cart_qty > 0
                          assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.increment
                        endif
                      -%}
                      {%- if product.quantity_price_breaks_configured? -%}
                        <price-per-item
                          id="Price-Per-Item-{{ section.id }}"
                          data-section-id="{{ section.id }}"
                          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                        >
                          {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                            {%- assign variant_price_compare = product.selected_or_first_available_variant.compare_at_price -%}
                            <div class="price-per-item">
                              {%- if variant_price_compare -%}
                                <dl class="price-per-item--current">
                                  <dt class="visually-hidden">
                                    {{ 'products.product.price.regular_price' | t }}
                                  </dt>
                                  <dd>
                                    <s class="variant-item__old-price">
                                      {{ variant_price_compare | money_with_currency }}
                                    </s>
                                  </dd>
                                </dl>
                              {%- endif -%}
                              {%- if current_qty_for_volume_pricing < volume_pricing_array.last.minimum_quantity -%}
                                {%- assign variant_price = product.selected_or_first_available_variant.price
                                  | money_with_currency
                                -%}
                                <span class="price-per-item--current">
                                  {{- 'products.product.volume_pricing.price_at_each_html' | t: price: variant_price -}}
                                </span>
                              {%- else -%}
                                {%- for price_break in volume_pricing_array -%}
                                  {%- if current_qty_for_volume_pricing >= price_break.minimum_quantity -%}
                                    {%- assign price_break_price = price_break.price | money_with_currency -%}
                                    <span class="price-per-item--current">
                                      {{-
                                        'products.product.volume_pricing.price_at_each_html'
                                        | t: price: price_break_price
                                      -}}
                                    </span>
                                    {%- break -%}
                                  {%- endif -%}
                                {%- endfor -%}
                              {%- endif -%}
                            </div>
                          {%- else -%}
                            {%- assign variant_price = product.selected_or_first_available_variant.price
                              | money_with_currency
                            -%}
                            {%- assign variant_price_compare = product.selected_or_first_available_variant.compare_at_price -%}
                            <div class="price-per-item">
                              {%- if variant_price_compare -%}
                                <dl class="price-per-item--current">
                                  <dt class="visually-hidden">
                                    {{ 'products.product.price.regular_price' | t }}
                                  </dt>
                                  <dd>
                                    <s class="variant-item__old-price">
                                      {{ variant_price_compare | money_with_currency }}
                                    </s>
                                  </dd>
                                  <dt class="visually-hidden">
                                    {{ 'products.product.price.sale_price' | t }}
                                  </dt>
                                  <dd>
                                    <span class="price-per-item--current">
                                      {{-
                                        'products.product.volume_pricing.price_at_each_html'
                                        | t: price: variant_price
                                      -}}
                                    </span>
                                  </dd>
                                </dl>
                              {%- else -%}
                                <span class="price-per-item--current">
                                  {{- 'products.product.volume_pricing.price_at_each_html' | t: price: variant_price -}}
                                </span>
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                        </price-per-item>
                      {%- endif -%}
                    </div>
                    <div class="quantity__rules caption" id="Quantity-Rules-{{ section.id }}">
                      {%- if product.selected_or_first_available_variant.quantity_rule.increment > 1 -%}
                        <span class="divider">
                          {{-
                            'products.product.quantity.multiples_of'
                            | t: quantity: product.selected_or_first_available_variant.quantity_rule.increment
                          -}}
                        </span>
                      {%- endif -%}
                      {%- if product.selected_or_first_available_variant.quantity_rule.min > 1 -%}
                        <span class="divider">
                          {{-
                            'products.product.quantity.minimum_of'
                            | t: quantity: product.selected_or_first_available_variant.quantity_rule.min
                          -}}
                        </span>
                      {%- endif -%}
                      {%- if product.selected_or_first_available_variant.quantity_rule.max != null -%}
                        <span class="divider">
                          {{-
                            'products.product.quantity.maximum_of'
                            | t: quantity: product.selected_or_first_available_variant.quantity_rule.max
                          -}}
                        </span>
                      {%- endif -%}
                    </div>
                    {%- if product.quantity_price_breaks_configured? -%}
                      <volume-pricing class="parent-display" id="Volume-{{ section.id }}">
                        {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                          <span class="caption-large">{{ 'products.product.volume_pricing.title' | t }}</span>
                          <ul class="list-unstyled">
                            <li>
                              <span>{{ product.selected_or_first_available_variant.quantity_rule.min }}+</span>
                              {%- assign price = product.selected_or_first_available_variant.price
                                | money_with_currency
                              -%}
                              <span data-text="{{ 'products.product.volume_pricing.price_at_each_html' | t: price: variant_price }}">
                                {{- 'sections.quick_order_list.each' | t: money: price -}}
                              </span>
                            </li>
                            {%- for price_break in product.selected_or_first_available_variant.quantity_price_breaks -%}
                              {%- assign price_break_price = price_break.price | money_with_currency -%}
                              <li class="{%- if forloop.index >= 3 -%}show-more-item hidden{%- endif -%}">
                                <span>
                                  {{- price_break.minimum_quantity -}}
                                  <span aria-hidden="true">+</span></span
                                >
                                <span data-text="{{ 'products.product.volume_pricing.price_at_each_html' | t: price: price_break_price }}">
                                  {{- 'sections.quick_order_list.each' | t: money: price_break_price -}}
                                </span>
                              </li>
                            {%- endfor -%}
                          </ul>
                          {%- if product.selected_or_first_available_variant.quantity_price_breaks.size >= 3 -%}
                            <show-more-button>
                              <button
                                class="button-show-more link underlined-link"
                                id="Show-More-{{ section.id }}"
                                type="button"
                              >
                                <span class="label-show-more label-text"
                                  ><span aria-hidden="true">+ </span>{{ 'products.facets.show_more' | t }}
                                </span>
                              </button>
                            </show-more-button>
                          {%- endif -%}
                        {%- endif -%}
                      </volume-pricing>
                    {%- endif -%}
                  </div>
                {%- when 'popup' -%}
                  <modal-opener
                    class="product-popup-modal__opener quick-add-hidden"
                    data-modal="#PopupModal-{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    <button
                      id="ProductPopup-{{ block.id }}"
                      class="product-popup-modal__button link"
                      type="button"
                      aria-haspopup="dialog"
                    >
                      {{ block.settings.text | default: block.settings.page.title | escape }}
                    </button>
                  </modal-opener>
                {%- when 'share' -%}
                  {% liquid
                    assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin
                    render 'share-button', block: block, share_link: share_url
                  %}

                {%- when 'review' -%}
                   <div class="review-slider"  {{ block.shopify_attributes }}>
                   
                    <slideshow-swiper>

                      <div
                          class="slideshow__swiper swiper"
                          data-centeredslides="false"
                          data-slidesDesktop="1"
                          data-slidesTab="1"
                          data-slidesMobile="1"
                          data-autoPlay="true"
                          data-delay="6000"
                          data-loop="false"
                          data-freemode="false"
                          data-freemomentum="false"
                          data-mousewheel="false"
                          data-desktopspace="10"
                          data-tabspace="10"
                          data-mobilespace="10"
                        >


                                    <div class="swiper-wrapper">

                                          {% for i in (1..5) %}

                                              {% capture name %}review_name_{{ i }}{% endcapture %}
                                              {% capture date %}review_date_{{ i }}{% endcapture %}
                                              {% capture rating %}review_rating_{{ i }}{% endcapture %}
                                              {% capture text %}review_text_{{ i }}{% endcapture %}

                                              {% if block.settings[name] != blank %}

                                                  <div class="swiper-slide">

                                                      <div class="review-card">

                                                          <div class="review-header">

                                                          <div class="review-header__inner">

                                                        
                                                              <div class="review-author">

                                                                  <span>{{ block.settings[name] }}</span>

                                                                    <span class="verified-icon">
                                                                  <svg width="13" height="13" viewBox="0 0 13 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                        <path d="M11.4767 4.74797C11.2705 4.5325 11.0573 4.31047 10.9769 4.11523C10.9025 3.93641 10.8981 3.64 10.8937 3.35289C10.8855 2.81914 10.8768 2.2143 10.4562 1.79375C10.0357 1.3732 9.43086 1.36445 8.89711 1.35625C8.61 1.35187 8.31359 1.3475 8.13477 1.27312C7.94008 1.19273 7.7175 0.979453 7.50203 0.773281C7.12469 0.410703 6.69594 0 6.125 0C5.55406 0 5.12586 0.410703 4.74797 0.773281C4.5325 0.979453 4.31047 1.19273 4.11523 1.27312C3.9375 1.3475 3.64 1.35187 3.35289 1.35625C2.81914 1.36445 2.2143 1.3732 1.79375 1.79375C1.3732 2.2143 1.36719 2.81914 1.35625 3.35289C1.35187 3.64 1.3475 3.93641 1.27312 4.11523C1.19273 4.30992 0.979453 4.5325 0.773281 4.74797C0.410703 5.12531 0 5.55406 0 6.125C0 6.69594 0.410703 7.12414 0.773281 7.50203C0.979453 7.7175 1.19273 7.93953 1.27312 8.13477C1.3475 8.31359 1.35187 8.61 1.35625 8.89711C1.36445 9.43086 1.3732 10.0357 1.79375 10.4562C2.2143 10.8768 2.81914 10.8855 3.35289 10.8937C3.64 10.8981 3.93641 10.9025 4.11523 10.9769C4.30992 11.0573 4.5325 11.2705 4.74797 11.4767C5.12531 11.8393 5.55406 12.25 6.125 12.25C6.69594 12.25 7.12414 11.8393 7.50203 11.4767C7.7175 11.2705 7.93953 11.0573 8.13477 10.9769C8.31359 10.9025 8.61 10.8981 8.89711 10.8937C9.43086 10.8855 10.0357 10.8768 10.4562 10.4562C10.8768 10.0357 10.8855 9.43086 10.8937 8.89711C10.8981 8.61 10.9025 8.31359 10.9769 8.13477C11.0573 7.94008 11.2705 7.7175 11.4767 7.50203C11.8393 7.12469 12.25 6.69594 12.25 6.125C12.25 5.55406 11.8393 5.12586 11.4767 4.74797ZM8.62203 5.12203L5.55953 8.18453C5.5189 8.22521 5.47065 8.25748 5.41754 8.2795C5.36442 8.30151 5.30749 8.31284 5.25 8.31284C5.19251 8.31284 5.13558 8.30151 5.08246 8.2795C5.02935 8.25748 4.9811 8.22521 4.94047 8.18453L3.62797 6.87203C3.54588 6.78994 3.49976 6.6786 3.49976 6.5625C3.49976 6.4464 3.54588 6.33506 3.62797 6.25297C3.71006 6.17088 3.8214 6.12476 3.9375 6.12476C4.0536 6.12476 4.16494 6.17088 4.24703 6.25297L5.25 7.25648L8.00297 4.50297C8.0436