{{ 'section-brewing-tips.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 992px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_tab }}px;
      padding-bottom: {{ section.settings.padding_bottom_tab }}px;
    }
  }

  @media screen and (min-width: 1024px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .brewing-tips-{{ section.id }} {
    --tips-eyebrow: {{ section.settings.eyebrow_color }};
    --tips-accent: {{ section.settings.accent_color }};
    --tips-gap: {{ section.settings.card_gap }}px;
    --tips-radius: {{ section.settings.card_radius }}px;
    --tips-icon-size: {{ section.settings.icon_size }}px;
    --tips-columns: {{ section.settings.columns }};
  }
{%- endstyle -%}

<div
  class="brewing-tips brewing-tips-{{ section.id }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {% if settings.animations_reveal_on_scroll %}
    data-cascade
  {% endif %}
>
  <div class="{{ section.settings.page_width }}">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="brewing-tips__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="brewing-tips__eyebrow sub-heading">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          {%- comment -%}
            Wrap the accent half of the heading in <em>: it turns italic and
            takes the accent colour.
          {%- endcomment -%}
          <h2 class="brewing-tips__heading hxl inline-richtext">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="brewing-tips__list" role="list">
      {%- for block in section.blocks -%}
        <li
          class="brewing-tips__card color-{{ section.settings.color_scheme_card }} gradient"
          {{ block.shopify_attributes }}
        >
          <span class="brewing-tips__icon">
            {%- if block.settings.icon != blank -%}
              {% render 'icon-img' with image, image: block.settings.icon %}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </span>

          {%- if block.settings.label != blank -%}
            <p class="brewing-tips__label">{{ block.settings.label | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Brewing tips",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container-fluid",
          "label": "Full Width"
        }
      ],
      "default": "container",
      "label": "Layout Width"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Brewing tips"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap the accent words in <em> to set them italic in the accent colour.",
      "default": "Small habits, <em>better cups.</em>"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow colour",
      "default": "#a05e12"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Heading accent colour",
      "default": "#7a8f55"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_card",
      "label": "Card colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Cards per row",
      "default": 4
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Gap between cards",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Card corner radius",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 30
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Tab",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Tab",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "tip",
      "name": "Tip",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Leave empty to use a placeholder image."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Cover while steeping"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brewing tips",
      "blocks": [
        {
          "type": "tip",
          "settings": {
            "label": "Cover while steeping"
          }
        },
        {
          "type": "tip",
          "settings": {
            "label": "Use fresh water"
          }
        },
        {
          "type": "tip",
          "settings": {
            "label": "Enjoy hot or iced"
          }
        },
        {
          "type": "tip",
          "settings": {
            "label": "Store herbs in a cool, dry place"
          }
        }
      ]
    }
  ]
}
{% endschema %}
