 {{ 'section-icon-card-blocks.css' | asset_url | stylesheet_tag }}
{%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    @media screen and (min-width: 992px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_tab }}px;
        padding-bottom: {{ section.settings.padding_bottom_tab }}px;
      }
  }

    @media screen and (min-width: 1024px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  .icon-cards-wrapper {
    --icon-cards-columns: {{ section.settings.columns }};
  }


{%- endstyle -%}


<div  id="{{ section.settings.them_section_id |  default:"icon_card_section" }}"
  class="icon-cards-seciton icon-cards-{{ section.id }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient  isolate {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {% if settings.animations_reveal_on_scroll %}
    data-cascade
  {% endif %}
>
  <div class="{{ section.settings.page_width }}">
    {%- if section.settings.subheading != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="icon-cards__header">
        {%- if section.settings.subheading != blank -%}
          <p class="icon-cards__eyebrow sub-heading">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <div class="icon-cards__title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </div>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="icon-cards__intro rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="icon-cards-wrapper">
      {%- for block in section.blocks -%}
 
        {%- liquid
          assign card_url = block.settings.collection.url
          if card_url == blank
            assign card_url = block.settings.button_url
          endif
        -%}
        <div class="icon-card__item">
          <{% if card_url != blank %}a href="{{ card_url }}"{% else %}div{% endif %}
            class="icon-card  color-{{ section.settings.color_scheme_card }} gradient{% if block.settings.bg_image != blank %} icon-card--has-bg{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >

          <div class="icon-card-bg" aria-hidden="true" style="--overlay-bg: {{ section.settings.overlauy_color }};">
            {%- if block.settings.bg_image != blank -%}
              {{
                block.settings.bg_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'icon-card-bg__img',
                  widths: '300, 450, 600, 750, 900, 1100, 1200',
                  sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                  alt: ''
              }}
            {%- endif -%}
            <span class="cap">{{ block.settings.caption }}</span>
          </div>


            <div class="icon-card__icon">
              {% if block.settings.image != blank %}
                {% render 'icon-img' with image, image: block.settings.image %}

              {% elsif block.settings.svg_icon != blank %}
                {{ block.settings.svg_icon }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>

            <div class="icon-card__content">
              {% if block.settings.title != blank %}
                <h3 class="icon-card__title">{{ block.settings.title }}</h3>
              {% endif %}
             
            </div>
             {%- if block.settings.button_text != blank -%}
                <span class="icon-card__link">
                  <span class="button--text">{{- block.settings.button_text -}}
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M13.8538 8.35403L9.35375 12.854C9.25993 12.9478 9.13268 13.0006 9 13.0006C8.86732 13.0006 8.74007 12.9478 8.64625 12.854C8.55243 12.7602 8.49972 12.633 8.49972 12.5003C8.49972 12.3676 8.55243 12.2403 8.64625 12.1465L12.2931 8.50028H2.5C2.36739 8.50028 2.24021 8.4476 2.14645 8.35383C2.05268 8.26006 2 8.13289 2 8.00028C2 7.86767 2.05268 7.74049 2.14645 7.64672C2.24021 7.55296 2.36739 7.50028 2.5 7.50028H12.2931L8.64625 3.85403C8.55243 3.76021 8.49972 3.63296 8.49972 3.50028C8.49972 3.3676 8.55243 3.24035 8.64625 3.14653C8.74007 3.05271 8.86732 3 9 3C9.13268 3 9.25993 3.05271 9.35375 3.14653L13.8538 7.64653C13.9002 7.69296 13.9371 7.74811 13.9623 7.80881C13.9874 7.86951 14.0004 7.93457 14.0004 8.00028C14.0004 8.06599 13.9874 8.13105 13.9623 8.19175C13.9371 8.25245 13.9002 8.30759 13.8538 8.35403Z" fill="currentColor"/>
                    </svg>
                  </span>
                </span>
              {%- endif -%}

              {% if block.settings.text != blank %}
                <p class="icon-card__text">{{ block.settings.text }}</p>
              {% endif %}
          </{% if card_url != blank %}a{% else %}div{% endif %}>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Icon Card Blocks",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container-fluid",
          "label": "Full Width"
        }
      ],
      "default": "container-fluid",
      "label": "Layout Width"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find your tea"
    },
    {
      "type": "richtext",
      "id": "heading",
      "default": "<p>Don't shop by herb. Shop by <em>how you want to feel.</em></p>",
      "label": "t:sections.multicolumn.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "hxl",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>You don't need to know your linden from your lemon balm. Tell us what your body's asking for, and we'll point you to the wild herbs traditionally trusted for it.</p>"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Highlight color",
      "info": "Italic text in the heading and the herb line on each card.",
      "default": "#7a8f55"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_card",
      "label": "Card color",
      "default": "scheme-1"
    },
      {
      "type": "color_background",
      "id": "overlauy_color",
      "label": "Overlay card color",
      "default": "linear-gradient(to top,#fffdf4fa,#fffdf4f0,#fffdf473)"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Tab",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Tab",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 48
    },
       {
      "type": "text",
      "id": "them_section_id",
      "label": "Section Id"
    }
  ],
  "blocks": [
    {
      "type": "icon_card",
      "name": "icon Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": " Image"
        },
        {
          "type": "liquid",
          "id": "svg_icon",
          "label": "Svg Icon"
        },
        {
          "type": "image_picker",
          "id": "bg_image",
          "label": "Card background image",
          "info": "Optional. Leave empty to keep the default card background."
        },
        {
          "type": "inline_richtext",
          "id": "caption",
          "default": "Photo: lifestyle scene + the ritual\\'s teas",
          "label": "Caption"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "default": "t:sections.multicolumn.blocks.column.settings.title.default",
          "label": "t:sections.multicolumn.blocks.column.settings.title.label"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "St John's Wort · Linden · Lemon Balm",
          "label": "Herbs / footnote"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "The whole card links here."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Link label",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL",
          "info": "Used when no collection is selected."
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "primary-outline",
              "label": "Primary outline"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "secondary-outline",
              "label": "Secondary outline"
            }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon Card Blocks",
      "blocks": [
        {
          "type": "icon_card"
        },
        {
          "type": "icon_card"
        },
        {
          "type": "icon_card"
        },
        {
          "type": "icon_card"
        }
      ]
    }
  ]
}
{% endschema %}
