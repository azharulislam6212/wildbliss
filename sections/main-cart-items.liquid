      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 40
    }
  ],
    "blocks": [
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1,
       "settings": [
        {
          "type": "checkbox",
          "id": "show_additional_button",
          "default": false,
          "label": "Show additional button"
        }
      ]
    },
       {
      "type": "payement_secure",
      "name": "Payement Secure",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "payment__title",
          "default": "Payment Accepts",
          "label": "Payment title"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_payment_icon",
          "default": true,
          "label": "Enable custom payment"
        }
      ]
    },
       {
      "type": "icon_text",
      "name": "Icon text",
       "limit": 1,
      "settings": [
            {
          "type": "image_picker",
          "id": "icon_1",
          "label": "Icon image"
        },
        {
          "type": "inline_richtext",
          "id": "text_1",
          "label": "text",
          "default": "Store Pickup Available Order Now"
        },
                  {
          "type": "image_picker",
          "id": "icon_2",
          "label": "Icon image"
        },
        {
          "type": "inline_richtext",
          "id": "text_2",
          "label": "text",
          "default": "Prefer to order by phone? Call Us"
        }
      ]
    },
      {
      "type": "scroll_item",
      "name": "Scroll Icons Item",
       "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_1",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title_1",
          "label": "Title",
          "default": "Free Shippping"
        },
          {
          "type": "image_picker",
          "id": "icon_2",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title_2",
          "label": "Title",
          "default": "Free Shippping"
        },
                 {
          "type": "image_picker",
          "id": "icon_3",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title_3",
          "label": "Title",
          "default": "Free Shippping"
        },
        {
          "type": "image_picker",
          "id": "icon_4",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title_4",
          "label": "Title",
          "default": "Free Shippping"
        },
                {
          "type": "image_picker",
          "id": "icon_5",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title_5",
          "label": "Title",
          "default": "Free Shippping"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "default": "scheme-1"
        },
            {
      "type": "select",
      "id": "speed",
      "label": "Speed",
      "default": "50",
      "options": [
        {
          "value": "50",
          "label": "50"
        },
        {
          "value": "100",
          "label": "100"
        },
        {
          "value": "150",
          "label": "150"
        },
        {
          "value": "200",
          "label": "200"
        }
      ]
    },
    {
      "type": "select",
      "label": "Movine Direction",
      "id": "moving_direction",
      "options": [
        {
          "value": "animation-direction",
          "label": "animation-direction"
        },
        {
          "value": "animation-reverse",
          "label": "animation-reverse"
        }
      ],
      "default": "animation-direction"
    },
    {
      "type": "checkbox",
      "id": "pause_when_hover",
      "label": "Pause On Hover",
      "default": false
    }
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
