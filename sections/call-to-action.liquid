{{ 'section-cta.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 992px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_tab }}px;
      padding-bottom: {{ section.settings.padding_bottom_tab }}px;
    }
  }

  @media screen and (min-width: 1024px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .call-to-action-{{ section.id }} {
    --cta-accent: {{ section.settings.accent_color }};
    --cta-max-width: {{ section.settings.content_width }}px;
    --cta-heading-size: {{ section.settings.heading_size }}px;
    --cta-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --cta-text-width-desktop: {{ section.settings.text_width }}px;
    --cta-text-width: {{ section.settings.text_width_mobile }}px;
  }
{%- endstyle -%}

<div
  class="call-to-action call-to-action-{{ section.id }} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding gradient isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {% if settings.animations_reveal_on_scroll %}
    data-cascade
  {% endif %}
>
  <div class="{{ section.settings.page_width }}">
    <div class="call-to-action__inner">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- if block.settings.heading != blank -%}
              {%- comment -%}
                Wrap the accent half of the heading in <em>: it turns italic and
                takes the accent colour.
              {%- endcomment -%}
              <h2 class="call-to-action__heading inline-richtext" {{ block.shopify_attributes }}>
                {{ block.settings.heading }}
              </h2>
            {%- endif -%}

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="call-to-action__text rte" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}

      {%- liquid
        assign buttons = section.blocks | where: 'type', 'button'
      -%}

      {%- if buttons.size > 0 -%}
        <div class="call-to-action__actions">
          {%- for block in buttons -%}
            {%- if block.settings.button_label != blank -%}
              <a
                {% if block.settings.button_link == blank %}
                  role="link"
                  aria-disabled="true"
                {% else %}
                  href="{{ block.settings.button_link }}"
                {% endif %}
                class="button button--{{ block.settings.button_style }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Call to action",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container-fluid",
          "label": "Full Width"
        }
      ],
      "default": "container",
      "label": "Layout Width"
    },
    {
      "type": "color",
      "id": "accent_color",
      "default": "#7A8F55",
      "label": "Accent colour",
      "info": "Used for the italic half of the heading."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 480,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "label": "Content width",
      "default": 1140
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 32,
      "max": 112,
      "step": 1,
      "unit": "px",
      "label": "Heading size on desktop",
      "default": 72
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 22,
      "max": 56,
      "step": 1,
      "unit": "px",
      "label": "Heading size on mobile",
      "default": 36
    },
    {
      "type": "range",
      "id": "text_width",
      "min": 280,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Text width on desktop",
      "default": 460
    },
    {
      "type": "range",
      "id": "text_width_mobile",
      "min": 240,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Text width on mobile",
      "default": 340
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Desktop",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Desktop",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Tab",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Tab",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.image-with-text.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Thank you for bringing <em>our mountains home.</em>",
          "label": "t:sections.image-with-text.blocks.heading.settings.heading.label",
          "info": "Text inside <em> is italic and takes the accent colour."
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.image-with-text.blocks.text.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Every canister carries a little of the village we grew up in. We hope it finds a place in your kitchen, and your rituals.</p>",
          "label": "t:sections.image-with-text.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.image-with-text.blocks.button.name",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Shop Our Teas",
          "label": "t:sections.image-with-text.blocks.button.settings.button_label.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.image-with-text.blocks.button.settings.button_link.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "primary",
              "label": "Filled"
            },
            {
              "value": "outline",
              "label": "Outline"
            }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Call to action",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button",
          "settings": {
            "button_label": "Shop Our Teas",
            "button_style": "primary"
          }
        },
        {
          "type": "button",
          "settings": {
            "button_label": "Say hello",
            "button_style": "outline"
          }
        }
      ]
    }
  ]
}
{% endschema %}
