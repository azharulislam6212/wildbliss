{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 992px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_tab }}px;
      padding-bottom: {{ section.settings.padding_bottom_tab }}px;
    }
  }

  @media screen and (min-width: 1024px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .rich-text-{{ section.id }} {
    --rt-accent: {{ section.settings.accent_color }};
    --rt-max-width: {{ section.settings.content_width }}px;
    --rt-heading-size: {{ section.settings.heading_size }}px;
    --rt-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --rt-text-width-desktop: {{ section.settings.text_width }}px;
    --rt-text-width: {{ section.settings.text_width_mobile }}px;
  }
{%- endstyle -%}

<div
  class="rich-text rich-text-{{ section.id }} rich-text--{{ section.settings.content_alignment }} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding gradient isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {% if settings.animations_reveal_on_scroll %}
    data-cascade
  {% endif %}
>
  <div class="{{ section.settings.page_width }}">
    <div class="rich-text__blocks">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'caption' -%}
            {%- if block.settings.caption != blank -%}
              <p class="rich-text__caption sub-heading" {{ block.shopify_attributes }}>
                {{- block.settings.caption | escape -}}
              </p>
            {%- endif -%}

          {%- when 'heading' -%}
            {%- if block.settings.heading != blank -%}
              {%- comment -%}
                Wrap the accent half of the heading in <em>: it turns italic and
                takes the accent colour.
              {%- endcomment -%}
              <h2 class="rich-text__heading inline-richtext" {{ block.shopify_attributes }}>
                {{ block.settings.heading }}
              </h2>
            {%- endif -%}

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="rich-text__text rte" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}

      {%- liquid
        assign buttons = section.blocks | where: 'type', 'button'
      -%}

      {%- if buttons.size > 0 -%}
        <div class="rich-text__buttons">
          {%- for block in buttons -%}
            {%- if block.settings.button_label != blank -%}
              <a
                {% if block.settings.button_link == blank %}
                  role="link"
                  aria-disabled="true"
                {% else %}
                  href="{{ block.settings.button_link }}"
                {% endif %}
                class="button button--{{ block.settings.button_style }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.rich-text.name",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container-fluid",
          "label": "Full Width"
        }
      ],
      "default": "container",
      "label": "Layout Width"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.content_alignment.options__2.label"
        },
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.content_alignment.options__1.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.content_alignment.label"
    },
    {
      "type": "color",
      "id": "accent_color",
      "default": "#7A8F55",
      "label": "Accent colour",
      "info": "Used for the italic half of the heading."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 400,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "label": "Content width",
      "default": 1140
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 112,
      "step": 1,
      "unit": "px",
      "label": "Heading size on desktop",
      "default": 60
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 56,
      "step": 1,
      "unit": "px",
      "label": "Heading size on mobile",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_width",
      "min": 280,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Text width on desktop",
      "default": 420
    },
    {
      "type": "range",
      "id": "text_width_mobile",
      "min": 240,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Text width on mobile",
      "default": 340
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Desktop",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Desktop",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Tab",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Tab",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "caption",
      "name": "t:sections.image-with-text.blocks.caption.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "caption",
          "default": "Contact",
          "label": "t:sections.image-with-text.blocks.caption.settings.text.label"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.rich-text.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "We're Here <em>to Help</em>",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label",
          "info": "Text inside <em> is italic and takes the accent colour."
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.rich-text.blocks.text.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Questions about our teas? We'd love to hear from you.</p>",
          "label": "t:sections.rich-text.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.rich-text.blocks.buttons.name",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.rich-text.blocks.buttons.settings.button_label_1.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.rich-text.blocks.buttons.settings.button_link_1.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "primary",
              "label": "Filled"
            },
            {
              "value": "outline",
              "label": "Outline"
            }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich-text.presets.name",
      "blocks": [
        {
          "type": "caption"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}
