{{ 'section-image-multicard.css' | asset_url | stylesheet_tag }}
{%- style -%}

  .section-{{ section.id }}-padding {
    --color-accent: {{ section.settings.color_accent.red }},   {{ section.settings.color_accent.green }},  {{ section.settings.color_accent.blue }};
    --color-link: {{ section.settings.color_accent.red }},  {{ section.settings.color_accent.green }}, {{ section.settings.color_accent.blue }};
  }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    @media screen and (min-width: 992px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_tab }}px;
        padding-bottom: {{ section.settings.padding_bottom_tab }}px;
      }
  }

    @media screen and (min-width: 1024px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
{%- endstyle -%}

<div
  class="image-multicard section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient  isolate {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {% if settings.animations_reveal_on_scroll %}
    data-cascade
  {% endif %}
>
  <div class="{{ section.settings.page_width }}">
    {%- unless section.settings.heading == blank -%}
      <div class="row">
        <div class="section--header text-center col-12 m-auto">
             {% if section.settings.pre_text != blank %}
                <p class="section--pre-text">{{ section.settings.pre_text }}</p>
              {% endif %}

          <h2 class="section--title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
            {% if section.settings.text != blank %}
            <div class="section--text">{{ section.settings.text }}</div>
          {% endif %}

        </div>
      </div>
    {%- endunless -%}
    <div class="row row-cols-lg-{{ section.settings.column }} row-cols-md-2 row-cols-sm-2  row-cols-1 img-card-row">
      {%- for block in section.blocks -%}
        <div class="col">
          <div class="image-card color-{{ section.settings.color_scheme_card }} gradient  {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"  style=" --color-accent: {{ section.settings.color_accent.red }},   {{ section.settings.color_accent.green }},  {{ section.settings.color_accent.blue }};"  {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}>

              <div class="image-card__image"> 
            {% if block.settings.image != blank %}
        
             {% render 'responsive-img' with image, image: block.settings.image %}

       
            {% else %}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
               </div>
       
            <div class="image-card__content">
               {% if block.settings.pre_text != blank %}
                <p class="image-card__pre_text">
                  <svg width="20" height="8" viewBox="0 0 20 8" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0.5 3.18188H0V4.18188H0.5V3.68188V3.18188ZM19.8536 4.03544C20.0488 3.84018 20.0488 3.52359 19.8536 3.32833L16.6716 0.146351C16.4763 -0.0489113 16.1597 -0.0489113 15.9645 0.146351C15.7692 0.341613 15.7692 0.658195 15.9645 0.853458L18.7929 3.68188L15.9645 6.51031C15.7692 6.70557 15.7692 7.02216 15.9645 7.21742C16.1597 7.41268 16.4763 7.41268 16.6716 7.21742L19.8536 4.03544ZM0.5 3.68188V4.18188H19.5V3.68188V3.18188H0.5V3.68188Z" fill="#FF0000"/>
              </svg>

                {{ block.settings.pre_text }}</p>
              {% endif %}
              {% if block.settings.title != blank %}
                <h3 class="image-card__title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="image-card__text">
                  {{ block.settings.text }}
                </p>
              {% endif %}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

