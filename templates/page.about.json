    "our_history_dPyHNj": {
      "type": "our-history",
      "blocks": {
        "text_block_4APTTH": {
          "type": "text_block",
          "settings": {
            "pre_text": "Our History",
            "heading": "For Nearly 6 Decades",
            "text": "<p>Snake River Farms was founded on a simple belief: quality matters. What  started as a family operation in American Falls, Idaho by Bob Rebholtz,  <br\/><br\/>Sr, has grown into a legacy of premium American Wagyu and Kurobuta pork  with operations throughout the Northwest.<br\/><br\/>Through decades of dedication to craft and innovation, <br\/><br\/>we've remained  committed to raising the finest beef and pork in America and providing  exceptional customer service.<\/p>",
            "button_text": "",
            "button_url": "",
            "button_style": "primary",
            "color_accent": "#a5a5a5",
            "color_scheme": ""
          }
        },
        "image_yrJUKR": {
          "type": "image",
          "settings": {
            "image": "shopify:\/\/shop_images\/Rectangle_39.png",
            "image_link": ""
          }
        },
        "card_block_BrcdJE": {
          "type": "card_block",
          "settings": {
            "text_1": "<p><strong>January - 1917<\/strong><\/p><p>J.J. and B.A Simon found Table Supply Meat Company in Omaha, NE. <\/p>",
            "text_2": "<p><strong>September - 1942<br\/><\/strong>Our steaks are served on cross-country trains. Nebraska Beef becomes famous.<\/p>",
            "text_3": "<p><strong>February - 1952<\/strong><\/p><p>Lester Simon starts selling steak through magazine ads and mail flyers. A first!<\/p>",
            "text_4": "<p><strong>October - 1966<\/strong><\/p><p>The world gets to know our new name Omaha Steaks<\/p>",
            "text_5": "<p><strong>December - 2017<\/strong><\/p><p>The first Omaha Steaks retail store opens for business in Nebraska.<\/p>",
            "text_6": "<p><strong>January - 2022<\/strong><\/p><p>The Simon Family & Omaha Steaks celebrate a centennial.<\/p>",
            "color_accent": "#ff2e2e"
          }
        }
      },
