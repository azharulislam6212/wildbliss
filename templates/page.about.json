    "image_mulit_card_dUX9qW": {
      "type": "image-mulit-card",
      "blocks": {
        "image_block_zXBVMe": {
          "type": "image_block",
          "settings": {
            "image": "shopify:\/\/shop_images\/Image_1.png",
            "pre_text": "Thoughtfully raised",
            "title": "Ranching & Feeding",
            "text": "Our cattle are raised on family ranches with the highest standards of animal welfare and sustainability. After grazing, they are finished on  carefully formulated rations developed by our in-house animal  nutritionists."
          }
        },
        "image_block_TQUQHD": {
          "type": "image_block",
          "settings": {
            "image": "shopify:\/\/shop_images\/Image_2_6a86db59-9d77-44d8-b5e0-70e6a3d6878f.png",
            "pre_text": "Handled with care",
            "title": "Processing",
            "text": "We process every animal at our state-of-the-art facilities in Washington  and Idaho. Our master butchers bring exceptional quality and flavor to  every cut through meticulous precision and craftsmanshi"
          }
        },
        "image_block_zWpQXX": {
          "type": "image_block",
          "settings": {
            "image": "shopify:\/\/shop_images\/Image_3.png",
            "pre_text": "Convenient Delivery",
            "title": "Direct To Your Door",
            "text": "We deliver straight to your door on the date you select, using specialized eco-friendly packaging that keeps your order at peak freshness. You can count on it arriving frozen or partially frozen — perfectly safe and  ready for your freezer"
          }
        }
      },
      "block_order": [
