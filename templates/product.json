        "collapsible_tab_gHHGJj": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "What's inside",
            "icon": "none",
            "content": "<p>100% organic wild hawthorn (<em>Crataegus monogyna<\/em>) leaf & flower. Nothing else — no flavourings, no fillers, no caffeine. Plant-based pyramid bags, plastic-free.<\/p>",
            "page": "",
            "open_by_default": false
          }
        },
        "collapsible_tab_6kiDNp": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Brewing guide",
            "icon": "none",
            "content": "<p>Pour 95–100°C water over one pyramid bag (or 1 tbsp loose). Steep 10–15 minutes, covered. Enjoy 1–3 cups daily.<\/p>",
            "page": "",
            "open_by_default": false
          }
        },
        "collapsible_tab_LGMFgD": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Sourcing & testing",
            "icon": "none",
            "content": "<p>Wildcrafted in certified-organic collection zones in the Romanian Carpathians. Ecocert inspects our wild collection areas and processing facility to verify compliance with USDA Organic standards, and every lot is tested for identity, purity, heavy metals and microbiology.<\/p>",
            "page": "",
            "open_by_default": false
          }
        },
        "collapsible_tab_DkbbQL": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & returns",
            "icon": "none",
            "content": "<p>Free U.S. shipping on orders over $50. Ships within 1–2 business days. Not happy? Full refund within 30 days — no need to return the tea.<\/p>",
            "page": "",
            "open_by_default": false
          }
        }
