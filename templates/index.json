    "image_with_card_TwtPxJ": {
      "type": "image-with-card",
      "blocks": {
        "caption_jqC4tB": {
          "type": "caption",
          "settings": {
            "caption": "From the source",
            "text_style": "caption-with-letter-spacing",
            "text_size": "medium"
          }
        },
        "heading_eKgVca": {
          "type": "heading",
          "settings": {
            "heading": "\"From the untouched meadows of theCarpathians, where wild herbs bloom ingolden light.\"",
            "heading_size": "h1"
          }
        },
        "text_Qb8fi8": {
          "type": "text",
          "settings": {
            "text": "<p>Sourced from wild meadows in the Carpathian Mountains, our<br\/>herbs are hand-picked at peak vitality and air-dried to preserve<br\/>their restorative benefits — one of Europe's last great primeval<br\/>landscapes, where plants grow exactly as they have for<br\/>millennia.<\/p>",
            "text_style": "body",
            "text_size": "medium"
          }
        },
        "numbered_item_EK9eri": {
          "type": "numbered_item",
          "settings": {
            "number": "01",
            "heading": "Wild, not farmed",
            "text": "<p>To withstand extreme cold, heat, and natural threats, wild plants develop<br\/>complex protective compounds that are difficult to reproduce under cultivation.<\/p>"
          }
        },
        "numbered_item_KrzabP": {
          "type": "numbered_item",
          "settings": {
            "number": "02",
            "heading": "Air-dried at source",
            "text": "<p>Picked by hand and dried within hours, on-site, locking in freshness and<br\/>botanical character.<\/p>"
          }
        },
        "numbered_item_FDMg6t": {
          "type": "numbered_item",
          "settings": {
            "number": "03",
            "heading": "Verified, not just claimed",
            "text": "<p>Ecocert inspects our wild collection areas and processing facility to verify<br\/>compliance with USDA Organic standards.<\/p>"
          }
        }
      },
